<ArcGIS defaultAssembly="EncDotNet.ArcGIS.SoundCharts.dll"
        defaultNamespace="EncDotNet.SoundCharts"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{ffae4aca-2edb-461d-8702-45b62936cf11}" version="0.0.0" desktopVersion="3.7.0">
    <Name>SoundCharts</Name>
    <Description>S-100 nautical chart portrayal from EncDotNet.S100. Not for navigation.</Description>
    <Author>Phillip Hoff</Author>
    <Company>EncDotNet.ArcGIS</Company>
    <Date>2026-11-13</Date>
    <Subject>Map Exploration</Subject>
  </AddInInfo>
  <conditions>
    <!-- Design brief §2.2: the SoundCharts Layer tab shows while the Contents
         selection includes a SoundCharts layer. The add-in sets the state from
         the layers' provenance markers. -->
    <insertCondition id="SoundCharts_HasChartLayerCondition" caption="A SoundCharts layer is selected">
      <state id="SoundCharts_ChartLayerSelectedState" />
    </insertCondition>
  </conditions>
  <modules>
    <!-- autoLoad: the module logs its versions when Pro starts, and later
         slices start the chart server before a project's SoundCharts layers
         draw. -->
    <insertModule id="SoundCharts_Module" className="SoundChartsModule" autoLoad="true" caption="SoundCharts">
      <tabs>
        <tab id="SoundCharts_Tab" caption="SoundCharts" keytip="SC">
          <group refID="SoundCharts_DataGroup" />
          <group refID="SoundCharts_DisplayGroup" />
          <group refID="SoundCharts_TimeGroup" />
          <group refID="SoundCharts_InquireGroup" />
          <group refID="SoundCharts_OutputGroup" />
          <group refID="SoundCharts_HelpGroup" />
        </tab>
        <!-- Design brief D2: one tab, SoundCharts, in the SoundCharts Layer tab
             group. A3 has Zoom to Data and the chart's Log; Datasets...,
             Coverage, Time and server status come with A7, A8 and later. -->
        <tab id="SoundCharts_LayerTab" caption="SoundCharts" condition="SoundCharts_HasChartLayerCondition"
             tabGroupID="SoundCharts_LayerTabGroup" keytip="SL">
          <group refID="SoundCharts_LayerDatasetsGroup" />
          <group refID="SoundCharts_LayerCoverageGroup" />
          <group refID="SoundCharts_LayerTimeGroup" />
          <group refID="SoundCharts_LayerServerGroup" />
        </tab>
      </tabs>
      <tabGroups>
        <tabGroup caption="SoundCharts Layer" id="SoundCharts_LayerTabGroup" />
      </tabGroups>
      <groups>
        <!-- Design proposal §5.1: two large buttons. Add SoundCharts Data's menu
             has Add Folder and Add as Feature Layers. -->
        <group id="SoundCharts_DataGroup" caption="Data" appearsOnAddInTab="false" keytip="D">
          <splitButton refID="SoundCharts_AddDataSplitButton" size="large" />
          <button refID="SoundCharts_LibraryButton" size="large" />
        </group>
        <!-- Design brief §2.1 and D5: palette, display category and the two quick
             toggles on the tab; everything else on the Options page. A5.
             Mariner Settings... is the group's dialog launcher (design
             proposal §5.2). -->
        <group id="SoundCharts_DisplayGroup" caption="Display" appearsOnAddInTab="false" keytip="P"
               launcherButtonID="SoundCharts_MarinerSettingsButton" launcherKeytip="M">
          <splitButton refID="SoundCharts_PaletteSplitButton" size="large" />
          <comboBox refID="SoundCharts_DisplayCategory" />
          <checkBox refID="SoundCharts_SoundingsCheckBox" />
          <checkBox refID="SoundCharts_TextCheckBox" />
        </group>
        <!-- Design brief §2.1, §6.6 and design proposal §10.9: the Time group
             on the main tab as well as the SoundCharts Layer tab. -->
        <group id="SoundCharts_TimeGroup" caption="Time" appearsOnAddInTab="false" keytip="T">
          <button refID="SoundCharts_MapTimeNow" size="large" />
          <button refID="SoundCharts_PreviousData" size="small" />
          <button refID="SoundCharts_NextData" size="small" />
        </group>
        <group id="SoundCharts_LayerDatasetsGroup" caption="Datasets" appearsOnAddInTab="false" keytip="D">
          <button refID="SoundCharts_ZoomToData" size="large" />
        </group>
        <!-- Design brief §2.2, D13 (A7): the Coverage layer and the zoom floor. -->
        <group id="SoundCharts_LayerCoverageGroup" caption="Coverage" appearsOnAddInTab="false" keytip="C">
          <checkBox refID="SoundCharts_Footprints" />
          <customControl refID="SoundCharts_ScaleNote" size="large" />
        </group>
        <!-- Design brief §6, D31, D32 (A8): map time drives the time layers. -->
        <group id="SoundCharts_LayerTimeGroup" caption="Time" appearsOnAddInTab="false" keytip="T">
          <button refID="SoundCharts_GoToNearestData" size="large" />
          <button refID="SoundCharts_MapTimeNow" size="large" />
        </group>
        <group id="SoundCharts_LayerServerGroup" caption="Server" appearsOnAddInTab="false" keytip="S">
          <button refID="SoundCharts_ChartLog" size="large" />
        </group>
        <group id="SoundCharts_InquireGroup" caption="Inquire" appearsOnAddInTab="false" keytip="I">
          <tool refID="SoundCharts_ObjectInfoTool" size="large" />
          <button refID="SoundCharts_RouteCheckButton" size="large" />
        </group>
        <!-- Design brief §2.1: produce output, after asking questions. -->
        <group id="SoundCharts_OutputGroup" caption="Output" appearsOnAddInTab="false" keytip="O">
          <button refID="SoundCharts_ExportChart" size="large" />
        </group>
        <group id="SoundCharts_HelpGroup" caption="Help" appearsOnAddInTab="false" keytip="H">
          <button refID="SoundCharts_LogButton" size="small" />
          <button refID="SoundCharts_AboutButton" size="small" />
        </group>
      </groups>
      <controls>
        <!-- Design brief §2.1: adds to the active map's SoundCharts group (D11).
             A Windows file dialog: the add-in claims no file types. -->
        <button id="SoundCharts_AddData" className="AddDataButton" caption="Add SoundCharts Data" keytip="A"
                loadOnClick="true" condition="esri_mapping_mapPane" largeImage="Images\AddSoundChartsData32.png" smallImage="Images\AddSoundChartsData16.png">
          <tooltip heading="Add SoundCharts Data">Add S-57 or S-101 cells, S-1xx HDF5 or GML datasets, or an exchange set (CATALOG.XML, CATALOG.031 or .zip) to the map as a SoundCharts chart. What each file is comes from its content. Not for navigation.<disabledText>Open a map to add SoundCharts data.</disabledText></tooltip>
        </button>
        <button id="SoundCharts_AddFolder" className="AddFolderButton" caption="Add Folder" keytip="F"
                loadOnClick="true" condition="esri_mapping_mapPane" largeImage="FolderOpenState32" smallImage="FolderOpenState16">
          <tooltip heading="Add SoundCharts Folder">Add an exchange-set folder, or every dataset in a folder, to the map as a SoundCharts chart.<disabledText>Open a map to add SoundCharts data.</disabledText></tooltip>
        </button>
        <!-- Issue #15: the plugin datasource's feature layers, in a
             SoundCharts features group outside the chart group (D14). -->
        <button id="SoundCharts_AddFeatureLayers" className="AddFeatureLayersButton" caption="Add as Feature Layers" keytip="T"
                loadOnClick="true" condition="esri_mapping_mapPane" largeImage="LayerNew32" smallImage="LayerNew16">
          <tooltip heading="Add as Feature Layers">Add the features of S-101, S-124, S-421 or S-57 datasets, or of an exchange set, to the map as feature layers, one per feature type, for selection, attribute tables, joins and geoprocessing. Pro draws them with its default symbols. Not for navigation.<disabledText>Open a map to add SoundCharts data.</disabledText></tooltip>
        </button>
        <button id="SoundCharts_OpenWithAddFeatureLayers" className="OpenWithAddFeatureLayersButton" caption="Add as Feature Layers"
                loadOnClick="true" condition="esri_mapping_mapPane" smallImage="LayerNew16" largeImage="LayerNew32">
          <tooltip heading="Add as Feature Layers">Add this data's features to the active map as feature layers, one per feature type, as Add as Feature Layers does. Not for navigation.<disabledText>Open a map to add SoundCharts data.</disabledText></tooltip>
        </button>
        <button id="SoundCharts_ZoomToData" className="ZoomToDataButton" caption="Zoom to Data" keytip="Z"
                loadOnClick="true" condition="SoundCharts_HasChartLayerCondition" largeImage="ZoomFullExtent32" smallImage="ZoomFullExtent16">
          <tooltip heading="Zoom to Data">Zoom to the footprints of the selected SoundCharts layer's datasets.<disabledText>Select a SoundCharts layer in Contents.</disabledText></tooltip>
        </button>
        <!-- Not loadOnClick: their tooltips carry the time layers' status. -->
        <button id="SoundCharts_GoToNearestData" className="GoToNearestDataButton" caption="Go to Nearest Data" keytip="G"
                loadOnClick="false" condition="SoundCharts_HasChartLayerCondition" largeImage="MapTime32" smallImage="MapTime16">
          <tooltip heading="Go to Nearest Data">Move map time to the nearest time a Water level or Surface currents layer has data. A layer with no data at map time draws nothing and says so here.<disabledText>Every Water level and Surface currents layer has data at map time.</disabledText></tooltip>
        </button>
        <button id="SoundCharts_MapTimeNow" className="MapTimeNowButton" caption="Now" keytip="W"
                loadOnClick="false" condition="esri_mapping_mapPane" largeImage="GenericTime32" smallImage="GenericTime16">
          <tooltip heading="Now">Set map time to now, once. Water level and Surface currents draw their nearest time step.<disabledText>The map has no map time: add a time-aware layer, such as Coverage, to show the time slider.</disabledText></tooltip>
        </button>
        <!-- Design brief §6.6: step map time through the time layers' steps. -->
        <button id="SoundCharts_PreviousData" className="PreviousDataButton" caption="Previous Data" keytip="V"
                loadOnClick="false" condition="esri_mapping_mapPane" largeImage="Images\PreviousData32.png" smallImage="Images\PreviousData16.png">
          <tooltip heading="Previous Data">Move map time to the previous time step of any Water level or Surface currents layer in the map. Pro's Time tab still steps by its own interval.<disabledText>No Water level or Surface currents layer has a time step before map time.</disabledText></tooltip>
        </button>
        <button id="SoundCharts_NextData" className="NextDataButton" caption="Next Data" keytip="N"
                loadOnClick="false" condition="esri_mapping_mapPane" largeImage="Images\NextData32.png" smallImage="Images\NextData16.png">
          <tooltip heading="Next Data">Move map time to the next time step of any Water level or Surface currents layer in the map. Pro's Time tab still steps by its own interval.<disabledText>No Water level or Surface currents layer has a time step after map time.</disabledText></tooltip>
        </button>
        <checkBox id="SoundCharts_Footprints" className="FootprintsCheckBox" caption="Footprints" keytip="F"
                  loadOnClick="false" condition="SoundCharts_HasChartLayerCondition">
          <tooltip heading="Footprints">Show or hide the Coverage layer: each dataset's footprint, labelled where the chart is out of scale.<disabledText>This map's SoundCharts chart has no Coverage layer.</disabledText></tooltip>
        </checkBox>
        <!-- A read-only note ("Zoom in to see the chart"). Pro's labelControl
             can't change its caption, so the note is a custom control. -->
        <customControl id="SoundCharts_ScaleNote" caption="Scale" className="ScaleNoteViewModel" keytip="N"
                       loadOnClick="false" condition="SoundCharts_HasChartLayerCondition" hideTooltip="false"
                       largeImage="Images\ScaleNote32.png" smallImage="Images\ScaleNote16.png">
          <content className="ScaleNoteView" />
          <tooltip heading="Scale Note">Says "Zoom in to see the chart" when the map is below the selected chart layer's minimum scale. Below it the chart server draws nothing, and the Coverage layer shows where the data is.<disabledText>Select a SoundCharts layer in Contents.</disabledText></tooltip>
        </customControl>
        <button id="SoundCharts_ChartLog" className="ChartLogButton" caption="Log" keytip="L"
                loadOnClick="true" condition="SoundCharts_HasChartLayerCondition" largeImage="DiagnosticsMonitor32" smallImage="DiagnosticsMonitor16">
          <tooltip heading="Chart Log">Show the SoundCharts Log for the selected layer's chart server.<disabledText>Select a SoundCharts layer in Contents.</disabledText></tooltip>
        </button>
        <button id="SoundCharts_AboutButton" className="AboutButton" caption="About SoundCharts" keytip="I"
                loadOnClick="true" largeImage="Images\AboutSoundCharts32.png" smallImage="Images\AboutSoundCharts16.png">
          <tooltip heading="About SoundCharts">Show the versions of SoundCharts, EncDotNet.S100, ArcGIS Pro and .NET.<disabledText /></tooltip>
        </button>
        <!-- Design brief D6: a SoundCharts map tool, not Pro's Explore. -->
        <tool id="SoundCharts_ObjectInfoTool" className="ObjectInfoTool" caption="Object Information" keytip="O"
              loadOnClick="true" condition="esri_mapping_mapPane" largeImage="Images\ObjectInformation32.png" smallImage="Images\ObjectInformation16.png">
          <tooltip heading="Object Information">Click the map to list every feature and coverage value of the SoundCharts layers there, in the SoundCharts Object Information pane.<disabledText>Open a map to use Object Information.</disabledText></tooltip>
        </tool>
        <!-- Issue #12, D10: renders the layout's SoundCharts layers at its
             scale and resolution for the export, instead of screen tiles. -->
        <button id="SoundCharts_ExportChart" className="ExportChartButton" caption="Export SoundCharts Chart..." keytip="E"
                loadOnClick="true" condition="esri_layouts_layoutPane" largeImage="GenericExport32" smallImage="GenericExport16">
          <tooltip heading="Export SoundCharts Chart">Export the active layout to PDF, PNG, JPEG or TIFF with its SoundCharts layers rendered at the layout's scale and resolution, so symbols print at their screen size and show the same content. Not for navigation.<disabledText>Open a layout to export a SoundCharts chart.</disabledText></tooltip>
        </button>
        <!-- Design brief §2.1, D7: opens the SoundCharts Route Check pane (A11). -->
        <button id="SoundCharts_RouteCheckButton" className="RouteCheckButton" caption="Route Check" keytip="R"
                loadOnClick="true" largeImage="Images\RouteCheck32.png" smallImage="Images\RouteCheck16.png">
          <tooltip heading="Route Check">Check a route (a line feature, a drawn line, or an S-421 or RTZ file) against the SoundCharts layers of the map, in the SoundCharts Route Check pane. Not for navigation.<disabledText /></tooltip>
        </button>
        <!-- Draw Route in the Route Check pane: a line sketch that's checked as a
             route when it's finished. Started from the pane, not the ribbon. -->
        <tool id="SoundCharts_RouteSketchTool" className="RouteSketchTool" caption="Draw Route" keytip="D"
              loadOnClick="true" condition="esri_mapping_mapPane" hidden="true" largeImage="EditingLineTool32" smallImage="EditingLineTool16">
          <tooltip heading="Draw Route">Draw a route on the map, then double-click to finish and check it.<disabledText>Open a map to draw a route.</disabledText></tooltip>
        </tool>
        <button id="SoundCharts_LogButton" className="ShowLogButton" caption="Log" keytip="L"
                loadOnClick="true" largeImage="DiagnosticsMonitor32" smallImage="DiagnosticsMonitor16">
          <tooltip heading="SoundCharts Log">Show add-in events and chart server output, to find out why a chart doesn't draw.<disabledText /></tooltip>
        </button>
        <!-- A5: the palette (D26, D27) and mariner settings (D5, D23–D25). -->
        <button id="SoundCharts_PaletteDay" className="PaletteDayButton" caption="Day" keytip="D"
                loadOnClick="false" largeImage="Images\\PaletteDay32.png" smallImage="Images\\PaletteDay16.png">
          <tooltip heading="Day Palette">Draw this project's SoundCharts layers in the Day palette, for print and daylight. These settings apply to SoundCharts layers only, not to Esri ENC layers.<disabledText /></tooltip>
        </button>
        <button id="SoundCharts_PaletteDusk" className="PaletteDuskButton" caption="Dusk" keytip="U"
                loadOnClick="false" largeImage="Images\\PaletteDusk32.png" smallImage="Images\\PaletteDusk16.png">
          <tooltip heading="Dusk Palette">Draw this project's SoundCharts layers in the Dusk palette, for a dark screen. These settings apply to SoundCharts layers only, not to Esri ENC layers.<disabledText /></tooltip>
        </button>
        <button id="SoundCharts_PaletteNight" className="PaletteNightButton" caption="Night" keytip="N"
                loadOnClick="false" largeImage="Images\\PaletteNight32.png" smallImage="Images\\PaletteNight16.png">
          <tooltip heading="Night Palette">Draw this project's SoundCharts layers in the Night palette, for a dark bridge. These settings apply to SoundCharts layers only, not to Esri ENC layers.<disabledText /></tooltip>
        </button>
        <button id="SoundCharts_PaletteFollowProTheme" className="FollowProThemeButton" caption="Follow Pro Theme" keytip="T"
                loadOnClick="false" largeImage="Images\\PaletteFollowProTheme32.png" smallImage="Images\\PaletteFollowProTheme16.png">
          <tooltip heading="Follow Pro Theme">Pro's Light theme shows the Day palette and its Dark theme the Dusk palette, in every project. Choosing a palette by hand turns this off.<disabledText /></tooltip>
        </button>
        <comboBox id="SoundCharts_DisplayCategory" className="DisplayCategoryComboBox" caption="Display Category" keytip="C"
                  loadOnClick="false" isEditable="false" isReadOnly="true" sizeString="Other Information  " itemWidth="140">
          <tooltip heading="Display Category">The ECDIS display category: Display Base, Standard, Other Information or All. These settings apply to SoundCharts layers only, not to Esri ENC layers.<disabledText>Needs a newer chart server: SoundCharts keeps the setting, and the chart draws with it once the chart server takes it.</disabledText></tooltip>
        </comboBox>
        <checkBox id="SoundCharts_SoundingsCheckBox" className="SoundingsCheckBox" caption="Soundings" keytip="S" loadOnClick="false">
          <tooltip heading="Soundings">Show or hide soundings on this project's SoundCharts layers.<disabledText>Needs a newer chart server: SoundCharts keeps the setting, and the chart draws with it once the chart server takes it.</disabledText></tooltip>
        </checkBox>
        <checkBox id="SoundCharts_TextCheckBox" className="TextCheckBox" caption="Text" keytip="X" loadOnClick="false">
          <tooltip heading="Text">Show or hide chart text on this project's SoundCharts layers. A change starts new chart servers, and the layers redraw from them.<disabledText /></tooltip>
        </checkBox>
        <button id="SoundCharts_MarinerSettingsButton" className="MarinerSettingsButton" caption="Mariner Settings..." keytip="M"
                loadOnClick="true" largeImage="GenericOptions32" smallImage="GenericOptions16">
          <tooltip heading="Mariner Settings">Set this project's palette and mariner settings on the SoundCharts page of Options. These settings apply to SoundCharts layers only, not to Esri ENC layers.<disabledText /></tooltip>
        </button>
        <!-- Issue #6: Open with SoundCharts on Pro's Catalog context menus. The
             dynamic menu adds SoundCharts_OpenWithMenu only when the
             right-clicked items hold chart data, read from their content; for
             anything else it adds nothing. hidden: not offered in ribbon
             customization. -->
        <dynamicMenu id="SoundCharts_OpenWithDynamicMenu" className="OpenWithDynamicMenu" caption="Open with SoundCharts"
                     hidden="true" smallImage="GenericOpen16">
          <tooltip heading="Open with SoundCharts">Shows SoundCharts commands for S-57 and S-1xx datasets, exchange sets and folders of them.<disabledText /></tooltip>
        </dynamicMenu>
        <button id="SoundCharts_OpenWithAddToMap" className="OpenWithAddToMapButton" caption="Add to Map"
                loadOnClick="true" condition="esri_mapping_mapPane" smallImage="AddContent16" largeImage="AddContent32">
          <tooltip heading="Add to Map">Add this data to the active map as a SoundCharts chart, as Add SoundCharts Data does. Not for navigation.<disabledText>Open a map to add SoundCharts data.</disabledText></tooltip>
        </button>
        <!-- Design brief §2.1, D9: opens the SoundCharts Library pane (issue #14). -->
        <button id="SoundCharts_LibraryButton" className="LibraryButton" caption="Library" keytip="B"
                loadOnClick="true" largeImage="CatalogShowTree32" smallImage="CatalogShowTree16">
          <tooltip heading="SoundCharts Library">Browse folders, exchange sets and collection manifests of S-57 and S-1xx data without loading them, then add datasets to the map, show their footprints or validate them.<disabledText /></tooltip>
        </button>
        <button id="SoundCharts_OpenWithAddToLibrary" className="OpenWithAddToLibraryButton" caption="Add to Library" keytip="L"
                loadOnClick="true" smallImage="CatalogShowTree16" largeImage="CatalogShowTree32">
          <tooltip heading="Add to Library">Add this data to the SoundCharts Library, indexed in place without loading it.<disabledText /></tooltip>
        </button>
      </controls>
      <splitButtons>
        <!-- Design proposal §5.1: a click adds files; the menu has the rest. -->
        <splitButton id="SoundCharts_AddDataSplitButton" keytip="A">
          <button refID="SoundCharts_AddData" />
          <button refID="SoundCharts_AddFolder" />
          <button refID="SoundCharts_AddFeatureLayers" />
        </splitButton>
        <!-- The face shows the active palette's image (PaletteFace). -->
        <splitButton id="SoundCharts_PaletteSplitButton" keytip="P">
          <button refID="SoundCharts_PaletteDay" />
          <button refID="SoundCharts_PaletteDusk" />
          <button refID="SoundCharts_PaletteNight" />
          <button refID="SoundCharts_PaletteFollowProTheme" />
        </splitButton>
      </splitButtons>
      <menus>
        <menu id="SoundCharts_OpenWithMenu" caption="Open with SoundCharts" smallImage="GenericOpen16">
          <tooltip heading="Open with SoundCharts">Add S-57 or S-1xx data to a map as a SoundCharts chart, or to the SoundCharts Library.<disabledText /></tooltip>
          <button refID="SoundCharts_OpenWithAddToMap" />
          <button refID="SoundCharts_OpenWithAddFeatureLayers" />
          <button refID="SoundCharts_OpenWithAddToLibrary" />
        </menu>
      </menus>
      <dockPanes>
        <dockPane id="SoundCharts_ObjectInfoPane" caption="SoundCharts Object Information" className="ObjectInfoPaneViewModel"
                  dock="group" dockWith="esri_core_projectDockPane" initiallyVisible="false" smallImage="Images\ObjectInformation16.png">
          <content className="ObjectInfoPaneView" />
        </dockPane>
        <dockPane id="SoundCharts_RouteCheckPane" caption="SoundCharts Route Check" className="RouteCheckPaneViewModel"
                  dock="group" dockWith="esri_core_projectDockPane" initiallyVisible="false" smallImage="Images\RouteCheck16.png">
          <content className="RouteCheckPaneView" />
        </dockPane>
        <dockPane id="SoundCharts_LogPane" caption="SoundCharts Log" className="LogPaneViewModel" dock="bottom"
                  keytip="L" autoHide="false">
          <content className="LogPaneView" />
        </dockPane>
        <!-- Design brief D3, D9: the viewer's Library model; drops on the pane add to it. -->
        <dockPane id="SoundCharts_LibraryPane" caption="SoundCharts Library" className="LibraryPaneViewModel"
                  dock="group" dockWith="esri_core_projectDockPane" smallImage="CatalogShowTree16">
          <content className="LibraryPaneView" />
        </dockPane>
      </dockPanes>
    </insertModule>
    <!-- Issue #6: the Catalog item context menus Pro 3.7 defines in
         Extensions\Catalog\ADGeoDatabase.daml (esri_geodatabase_module). Pro
         has no context menu for every file: each item type has its own, and
         files Pro doesn't recognize aren't shown in Catalog at all. These are
         the menus of the items S-1xx data shows as: folders, folder
         connections, ENC cells (S-57 and S-101 .000), raster datasets (HDF5)
         and XML documents (CATALOG.XML), and the menu for several selected
         items. Adding to them claims no file type. -->
    <updateModule refID="esri_geodatabase_module">
      <menus>
        <updateMenu refID="folderGeneralItemMenu">
          <insertDynamicMenu refID="SoundCharts_OpenWithDynamicMenu" inline="true" separator="true" />
        </updateMenu>
        <updateMenu refID="folderConnectionItemMenu">
          <insertDynamicMenu refID="SoundCharts_OpenWithDynamicMenu" inline="true" separator="true" />
        </updateMenu>
        <updateMenu refID="ENCItemMenu">
          <insertDynamicMenu refID="SoundCharts_OpenWithDynamicMenu" inline="true" separator="true" />
        </updateMenu>
        <updateMenu refID="rasterItemMenu">
          <insertDynamicMenu refID="SoundCharts_OpenWithDynamicMenu" inline="true" separator="true" />
        </updateMenu>
        <updateMenu refID="esri_core_XmlMenu">
          <insertDynamicMenu refID="SoundCharts_OpenWithDynamicMenu" inline="true" separator="true" />
        </updateMenu>
        <updateMenu refID="esri_geodatabase_ProjectMultiselectContextMenu">
          <insertDynamicMenu refID="SoundCharts_OpenWithDynamicMenu" inline="true" separator="true" />
        </updateMenu>
      </menus>
    </updateModule>
  </modules>
  <!-- Design brief D24: a SoundCharts page under Project (the project's mariner
       settings) and one under Application (defaults, Follow Pro theme, Time
       Format, the s100 program, the tile cache). -->
  <propertySheets>
    <updateSheet refID="esri_core_optionsPropertySheet">
      <insertPage id="SoundCharts_ProjectOptionsPage" caption="SoundCharts" className="ProjectOptionsViewModel" group="Project">
        <content className="ProjectOptionsView" />
      </insertPage>
      <insertPage id="SoundCharts_ApplicationOptionsPage" caption="SoundCharts" className="ApplicationOptionsViewModel" group="Application">
        <content className="ApplicationOptionsView" />
      </insertPage>
    </updateSheet>
  </propertySheets>
</ArcGIS>
