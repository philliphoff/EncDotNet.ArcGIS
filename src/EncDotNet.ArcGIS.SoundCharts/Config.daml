<ArcGIS defaultAssembly="EncDotNet.ArcGIS.SoundCharts.dll"
        defaultNamespace="EncDotNet.SoundCharts"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{ffae4aca-2edb-461d-8702-45b62936cf11}" version="0.0.0" desktopVersion="3.7.0">
    <Name>SoundCharts</Name>
    <Description>S-100 nautical chart portrayal from EncDotNet.S100. Not for navigation.</Description>
    <Author>Phillip Hoff</Author>
    <Company>EncDotNet.ArcGIS</Company>
    <Date>2026-11-13</Date>
    <Subject>Map Exploration</Subject>
  </AddInInfo>
  <modules>
    <!-- autoLoad: the module logs its versions when Pro starts, and later
         slices start the chart server before a project's SoundCharts layers
         draw. -->
    <insertModule id="SoundCharts_Module" className="SoundChartsModule" autoLoad="true" caption="SoundCharts">
      <tabs>
        <tab id="SoundCharts_Tab" caption="SoundCharts" keytip="SC">
          <group refID="SoundCharts_HelpGroup" />
        </tab>
      </tabs>
      <groups>
        <group id="SoundCharts_HelpGroup" caption="Help" appearsOnAddInTab="false" keytip="H">
          <button refID="SoundCharts_LogButton" size="large" />
          <button refID="SoundCharts_AboutButton" size="large" />
        </group>
      </groups>
      <controls>
        <button id="SoundCharts_AboutButton" className="AboutButton" caption="About SoundCharts" keytip="A"
                loadOnClick="true" largeImage="GenericInformation32" smallImage="GenericInformation16">
          <tooltip heading="About SoundCharts">Show the versions of SoundCharts, EncDotNet.S100, ArcGIS Pro and .NET.<disabledText /></tooltip>
        </button>
        <button id="SoundCharts_LogButton" className="ShowLogButton" caption="Log" keytip="L"
                loadOnClick="true" largeImage="DiagnosticsMonitor32" smallImage="DiagnosticsMonitor16">
          <tooltip heading="SoundCharts Log">Show add-in events and chart server output, to find out why a chart doesn't draw.<disabledText /></tooltip>
        </button>
      </controls>
      <dockPanes>
        <dockPane id="SoundCharts_LogPane" caption="SoundCharts Log" className="LogPaneViewModel" dock="bottom"
                  keytip="L" autoHide="false">
          <content className="LogPaneView" />
        </dockPane>
      </dockPanes>
    </insertModule>
  </modules>
</ArcGIS>
