<ArcGIS defaultAssembly="EncDotNet.ArcGIS.SoundCharts.dll"
        defaultNamespace="EncDotNet.SoundCharts"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{ffae4aca-2edb-461d-8702-45b62936cf11}" version="0.0.0" desktopVersion="3.7.0">
    <Name>SoundCharts</Name>
    <Description>S-100 nautical chart portrayal from EncDotNet.S100. Not for navigation.</Description>
    <Author>Phillip Hoff</Author>
    <Company>EncDotNet.ArcGIS</Company>
    <Date>2026-11-13</Date>
    <Subject>Map Exploration</Subject>
  </AddInInfo>
  <conditions>
    <!-- Design brief §2.2: the SoundCharts Layer tab shows while the Contents
         selection includes a SoundCharts layer. The add-in sets the state from
         the layers' provenance markers. -->
    <insertCondition id="SoundCharts_HasChartLayerCondition" caption="A SoundCharts layer is selected">
      <state id="SoundCharts_ChartLayerSelectedState" />
    </insertCondition>
  </conditions>
  <modules>
    <!-- autoLoad: the module logs its versions when Pro starts, and later
         slices start the chart server before a project's SoundCharts layers
         draw. -->
    <insertModule id="SoundCharts_Module" className="SoundChartsModule" autoLoad="true" caption="SoundCharts">
      <tabs>
        <tab id="SoundCharts_Tab" caption="SoundCharts" keytip="SC">
          <group refID="SoundCharts_DataGroup" />
          <group refID="SoundCharts_InquireGroup" />
          <group refID="SoundCharts_HelpGroup" />
        </tab>
        <!-- Design brief D2: one tab, SoundCharts, in the SoundCharts Layer tab
             group. A3 has Zoom to Data and the chart's Log; Datasets...,
             Coverage, Time and server status come with A7, A8 and later. -->
        <tab id="SoundCharts_LayerTab" caption="SoundCharts" condition="SoundCharts_HasChartLayerCondition"
             tabGroupID="SoundCharts_LayerTabGroup" keytip="SL">
          <group refID="SoundCharts_LayerDatasetsGroup" />
          <group refID="SoundCharts_LayerServerGroup" />
        </tab>
      </tabs>
      <tabGroups>
        <tabGroup caption="SoundCharts Layer" id="SoundCharts_LayerTabGroup" />
      </tabGroups>
      <groups>
        <group id="SoundCharts_DataGroup" caption="Data" appearsOnAddInTab="false" keytip="D">
          <button refID="SoundCharts_AddData" size="large" />
          <button refID="SoundCharts_AddFolder" size="middle" />
        </group>
        <group id="SoundCharts_LayerDatasetsGroup" caption="Datasets" appearsOnAddInTab="false" keytip="D">
          <button refID="SoundCharts_ZoomToData" size="large" />
        </group>
        <group id="SoundCharts_LayerServerGroup" caption="Server" appearsOnAddInTab="false" keytip="S">
          <button refID="SoundCharts_ChartLog" size="large" />
        </group>
        <group id="SoundCharts_InquireGroup" caption="Inquire" appearsOnAddInTab="false" keytip="I">
          <tool refID="SoundCharts_ObjectInfoTool" size="large" />
        </group>
        <group id="SoundCharts_HelpGroup" caption="Help" appearsOnAddInTab="false" keytip="H">
          <button refID="SoundCharts_LogButton" size="large" />
          <button refID="SoundCharts_AboutButton" size="large" />
        </group>
      </groups>
      <controls>
        <!-- Design brief §2.1: adds to the active map's SoundCharts group (D11).
             A Windows file dialog: the add-in claims no file types. -->
        <button id="SoundCharts_AddData" className="AddDataButton" caption="Add SoundCharts Data" keytip="A"
                loadOnClick="true" condition="esri_mapping_mapPane" largeImage="AddContent32" smallImage="AddContent16">
          <tooltip heading="Add SoundCharts Data">Add S-57 or S-101 cells, S-1xx HDF5 or GML datasets, or an exchange set (CATALOG.XML, CATALOG.031 or .zip) to the map as a SoundCharts chart. What each file is comes from its content. Not for navigation.<disabledText>Open a map to add SoundCharts data.</disabledText></tooltip>
        </button>
        <button id="SoundCharts_AddFolder" className="AddFolderButton" caption="Add Folder" keytip="F"
                loadOnClick="true" condition="esri_mapping_mapPane" largeImage="FolderOpenState32" smallImage="FolderOpenState16">
          <tooltip heading="Add SoundCharts Folder">Add an exchange-set folder, or every dataset in a folder, to the map as a SoundCharts chart.<disabledText>Open a map to add SoundCharts data.</disabledText></tooltip>
        </button>
        <button id="SoundCharts_ZoomToData" className="ZoomToDataButton" caption="Zoom to Data" keytip="Z"
                loadOnClick="true" condition="SoundCharts_HasChartLayerCondition" largeImage="ZoomFullExtent32" smallImage="ZoomFullExtent16">
          <tooltip heading="Zoom to Data">Zoom to the footprints of the selected SoundCharts layer's datasets.<disabledText>Select a SoundCharts layer in Contents.</disabledText></tooltip>
        </button>
        <button id="SoundCharts_ChartLog" className="ChartLogButton" caption="Log" keytip="L"
                loadOnClick="true" condition="SoundCharts_HasChartLayerCondition" largeImage="DiagnosticsMonitor32" smallImage="DiagnosticsMonitor16">
          <tooltip heading="Chart Log">Show the SoundCharts Log for the selected layer's chart server.<disabledText>Select a SoundCharts layer in Contents.</disabledText></tooltip>
        </button>
        <button id="SoundCharts_AboutButton" className="AboutButton" caption="About SoundCharts" keytip="A"
                loadOnClick="true" largeImage="GenericInformation32" smallImage="GenericInformation16">
          <tooltip heading="About SoundCharts">Show the versions of SoundCharts, EncDotNet.S100, ArcGIS Pro and .NET.<disabledText /></tooltip>
        </button>
        <!-- Design brief D6: a SoundCharts map tool, not Pro's Explore. -->
        <tool id="SoundCharts_ObjectInfoTool" className="ObjectInfoTool" caption="Object information" keytip="O"
              loadOnClick="true" condition="esri_mapping_mapPane" largeImage="Explore32" smallImage="Explore16">
          <tooltip heading="Object information">Click the map to list every feature and coverage value of the SoundCharts layers there, in the SoundCharts Object information pane.<disabledText>Open a map to use Object information.</disabledText></tooltip>
        </tool>
        <button id="SoundCharts_LogButton" className="ShowLogButton" caption="Log" keytip="L"
                loadOnClick="true" largeImage="DiagnosticsMonitor32" smallImage="DiagnosticsMonitor16">
          <tooltip heading="SoundCharts Log">Show add-in events and chart server output, to find out why a chart doesn't draw.<disabledText /></tooltip>
        </button>
      </controls>
      <dockPanes>
        <dockPane id="SoundCharts_ObjectInfoPane" caption="SoundCharts Object information" className="ObjectInfoPaneViewModel"
                  dock="group" dockWith="esri_core_projectDockPane" initiallyVisible="false" smallImage="Explore16">
          <content className="ObjectInfoPaneView" />
        </dockPane>
        <dockPane id="SoundCharts_LogPane" caption="SoundCharts Log" className="LogPaneViewModel" dock="bottom"
                  keytip="L" autoHide="false">
          <content className="LogPaneView" />
        </dockPane>
      </dockPanes>
    </insertModule>
  </modules>
</ArcGIS>
