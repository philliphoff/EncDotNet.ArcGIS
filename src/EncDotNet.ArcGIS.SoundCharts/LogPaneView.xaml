<UserControl x:Class="EncDotNet.SoundCharts.LogPaneView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:res="clr-namespace:EncDotNet.SoundCharts.Resources"
             AutomationProperties.AutomationId="LogPane">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </ResourceDictionary>
  </UserControl.Resources>

  <DockPanel Margin="4">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
      <ComboBox ItemsSource="{Binding Filters}"
                SelectedItem="{Binding SelectedFilter}"
                DisplayMemberPath="Label"
                MinWidth="180"
                AutomationProperties.AutomationId="LogPane.Filter"
                AutomationProperties.Name="{x:Static res:Strings.Log_Filter}" />
      <Button Content="{x:Static res:Strings.Button_CopyAll}"
              ToolTip="{x:Static res:Strings.Tooltip_LogCopyAll}"
              Command="{Binding CopyAllCommand}"
              Style="{DynamicResource Esri_Button}"
              Margin="8,0,0,0"
              AutomationProperties.AutomationId="LogPane.CopyAll"
              AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LogCopyAll}" />
      <Button Content="{x:Static res:Strings.Button_OpenLogFolder}"
              ToolTip="{x:Static res:Strings.Tooltip_LogOpenFolder}"
              Command="{Binding OpenLogFolderCommand}"
              Style="{DynamicResource Esri_Button}"
              AutomationProperties.AutomationId="LogPane.OpenLogFolder"
              AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LogOpenFolder}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top"
                Orientation="Horizontal"
                Margin="0,0,0,4"
                Visibility="{Binding HasSourceFilter, Converter={StaticResource BooleanToVisibility}}">
      <TextBlock Text="{Binding SourceFilterText}"
                 Style="{DynamicResource Esri_TextBlockRegular}"
                 VerticalAlignment="Center" />
      <Button Content="{x:Static res:Strings.Button_ShowAll}"
              ToolTip="{x:Static res:Strings.Tooltip_LogShowAll}"
              Command="{Binding ShowAllCommand}"
              Style="{DynamicResource Esri_Button}"
              Margin="8,0,0,0"
              AutomationProperties.AutomationId="LogPane.ShowAll"
              AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LogShowAll}" />
    </StackPanel>

    <ListView ItemsSource="{Binding Entries}"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              AutomationProperties.AutomationId="LogPane.Entries"
              AutomationProperties.Name="{x:Static res:Strings.Log_Entries}">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="{x:Static res:Strings.Log_Column_Time}" DisplayMemberBinding="{Binding Time}" Width="140" />
          <GridViewColumn Header="{x:Static res:Strings.Log_Column_Level}" DisplayMemberBinding="{Binding Level}" Width="60" />
          <GridViewColumn Header="{x:Static res:Strings.Log_Column_Source}" DisplayMemberBinding="{Binding Source}" Width="110" />
          <GridViewColumn Header="{x:Static res:Strings.Log_Column_Message}" DisplayMemberBinding="{Binding Message}" Width="800" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</UserControl>
