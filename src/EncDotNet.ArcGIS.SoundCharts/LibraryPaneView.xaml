<UserControl x:Class="EncDotNet.SoundCharts.LibraryPaneView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
             xmlns:library="clr-namespace:EncDotNet.SoundCharts.Library"
             xmlns:res="clr-namespace:EncDotNet.SoundCharts.Resources"
             xmlns:sc="clr-namespace:EncDotNet.SoundCharts.Themes"
             AllowDrop="True"
             DragEnter="OnDragOver"
             DragOver="OnDragOver"
             DragLeave="OnDragLeave"
             Drop="OnDrop"
             AutomationProperties.AutomationId="Library">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml" />
        <sc:SoundChartsTheme />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

      <!-- A product tag that collapses when there's no product: collections have none. -->
      <Style x:Key="OptionalProductTag" TargetType="ContentControl" BasedOn="{StaticResource SC_ProductTag}">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Style.Triggers>
          <Trigger Property="Content" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- A dataset's tag: neutral, or a warning chip with its glyph (Missing). -->
      <Style x:Key="TagChip" TargetType="ContentControl" BasedOn="{StaticResource SC_Chip}">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsWarning}" Value="True">
            <Setter Property="sc:Tone.Value" Value="Warning" />
            <Setter Property="sc:Ui.Glyph" Value="{StaticResource SC_GlyphCheck}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- A row's second line: a status or a title, in the warning colour for a problem. -->
      <Style x:Key="RowDetail" TargetType="TextBlock" BasedOn="{StaticResource SC_OptionalCaption}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsWarning}" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource SC_WarningBrush}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- The selected dataset's name: a title in the mono face, as ids are. -->
      <Style x:Key="DatasetTitle" TargetType="TextBlock" BasedOn="{StaticResource SC_Title}">
        <Setter Property="FontFamily" Value="{StaticResource SC_MonoFontFamily}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <!-- Shown while the Library has collections; the empty state replaces it. -->
      <Style x:Key="ShownWithCollections" TargetType="FrameworkElement">
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsEmpty}" Value="True">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- One row of the tree: a collection, a source or a dataset. -->
      <HierarchicalDataTemplate DataType="{x:Type library:LibraryNode}" ItemsSource="{Binding Children}">
        <StackPanel MinHeight="{StaticResource SC_RowHeight}" AutomationProperties.Name="{Binding Title}">
          <DockPanel>
            <Path DockPanel.Dock="Left"
                  Data="{StaticResource SC_GlyphLibrary}"
                  TextElement.Foreground="{DynamicResource Esri_TextStyleSubduedBrush}"
                  Margin="0,0,4,0">
              <Path.Style>
                <Style TargetType="Path" BasedOn="{StaticResource SC_Glyph}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static library:LibraryNodeKind.Collection}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
            <ContentControl DockPanel.Dock="Left" Content="{Binding ProductTag}" Style="{StaticResource OptionalProductTag}" />
            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Tags}" Focusable="False" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ContentControl Content="{Binding Text}" Style="{StaticResource TagChip}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding Meta}"
                       Style="{StaticResource SC_OptionalMono}"
                       TextWrapping="NoWrap"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource SC_Body}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
          </DockPanel>
          <DockPanel>
            <Path DockPanel.Dock="Left"
                  Data="{StaticResource SC_GlyphCheck}"
                  TextElement.Foreground="{DynamicResource SC_WarningBrush}"
                  VerticalAlignment="Center"
                  Margin="0,0,4,0">
              <Path.Style>
                <Style TargetType="Path" BasedOn="{StaticResource SC_GlyphSmall}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsWarning}" Value="True" />
                        <Condition Binding="{Binding HasDetail}" Value="True" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
            <TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}" Style="{StaticResource RowDetail}" />
          </DockPanel>
        </StackPanel>
      </HierarchicalDataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Add to the Library on the left; refresh, remove and the ≡ menu on the right. -->
    <Border Grid.Row="0" Style="{StaticResource SC_PaneToolbar}">
      <DockPanel LastChildFill="False">
        <Button Style="{StaticResource SC_ToolbarMenuButton}"
                sc:Ui.Glyph="{StaticResource SC_GlyphAdd}"
                Content="{x:Static res:Strings.Library_Add}"
                ToolTip="{x:Static res:Strings.Tooltip_LibraryAdd}"
                AutomationProperties.AutomationId="Library.Add"
                AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAdd}">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static res:Strings.Library_AddFolder}"
                        ToolTip="{x:Static res:Strings.Tooltip_LibraryAddFolder}"
                        Command="{Binding AddFolderCommand}"
                        AutomationProperties.AutomationId="Library.AddFolder"
                        AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddFolder}" />
              <MenuItem Header="{x:Static res:Strings.Library_AddExchangeSet}"
                        ToolTip="{x:Static res:Strings.Tooltip_LibraryAddExchangeSet}"
                        Command="{Binding AddExchangeSetCommand}"
                        AutomationProperties.AutomationId="Library.AddExchangeSet"
                        AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddExchangeSet}" />
              <MenuItem Header="{x:Static res:Strings.Library_AddManifest}"
                        ToolTip="{x:Static res:Strings.Tooltip_LibraryAddManifest}"
                        Command="{Binding AddManifestCommand}"
                        AutomationProperties.AutomationId="Library.AddManifest"
                        AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddManifest}" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>

        <!-- Docked right in reverse order: ≡ at the far right. -->
        <Button DockPanel.Dock="Right"
                Style="{StaticResource SC_BurgerButton}"
                Margin="{StaticResource SC_ToolbarItemGap}"
                ToolTip="{x:Static res:Strings.Tooltip_LibraryMore}"
                AutomationProperties.Name="{x:Static res:Strings.Tooltip_LibraryMore}"
                AutomationProperties.AutomationId="Library.More">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static res:Strings.Library_AddFolder}" ToolTip="{x:Static res:Strings.Tooltip_LibraryAddFolder}" Command="{Binding AddFolderCommand}" />
              <MenuItem Header="{x:Static res:Strings.Library_AddExchangeSet}" ToolTip="{x:Static res:Strings.Tooltip_LibraryAddExchangeSet}" Command="{Binding AddExchangeSetCommand}" />
              <MenuItem Header="{x:Static res:Strings.Library_AddManifest}" ToolTip="{x:Static res:Strings.Tooltip_LibraryAddManifest}" Command="{Binding AddManifestCommand}" />
              <Separator />
              <MenuItem Header="{x:Static res:Strings.Library_Refresh}" ToolTip="{x:Static res:Strings.Tooltip_LibraryRefresh}" Command="{Binding RefreshCommand}" />
              <MenuItem Header="{x:Static res:Strings.Library_Remove}" ToolTip="{x:Static res:Strings.Tooltip_LibraryRemove}" Command="{Binding RemoveCommand}" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button DockPanel.Dock="Right"
                Style="{StaticResource SC_IconButton}"
                sc:Ui.Glyph="{StaticResource SC_GlyphClose}"
                Margin="{StaticResource SC_ToolbarItemGap}"
                Command="{Binding RemoveCommand}"
                ToolTip="{x:Static res:Strings.Tooltip_LibraryRemove}"
                AutomationProperties.Name="{x:Static res:Strings.Library_Remove}"
                AutomationProperties.AutomationId="Library.Remove"
                AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryRemove}" />
        <Button DockPanel.Dock="Right"
                Style="{StaticResource SC_IconButton}"
                sc:Ui.Glyph="{StaticResource SC_GlyphRefresh}"
                Command="{Binding RefreshCommand}"
                ToolTip="{x:Static res:Strings.Tooltip_LibraryRefresh}"
                AutomationProperties.Name="{x:Static res:Strings.Library_Refresh}"
                AutomationProperties.AutomationId="Library.Refresh"
                AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryRefresh}" />
      </DockPanel>
    </Border>

    <!-- The Library's collections: search, tree and the selected dataset's details. -->
    <Grid Grid.Row="1" Margin="{StaticResource SC_PaneGutter}" Style="{StaticResource ShownWithCollections}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="80" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="80" />
      </Grid.RowDefinitions>

      <!-- The viewer's filter. -->
      <controls:SearchTextBox x:Name="Filter"
                              Grid.Row="0"
                              Margin="0,0,0,8"
                              Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                              InfoText="{x:Static res:Strings.Library_FilterWatermark}"
                              AutomationProperties.AutomationId="Library.Filter"
                              AutomationProperties.Name="{x:Static res:Strings.Library_Filter}" />

      <!-- Collections, sources and datasets. -->
      <TreeView x:Name="Tree"
                Grid.Row="1"
                ItemsSource="{Binding Nodes}"
                SelectedItemChanged="OnSelectedItemChanged"
                BorderThickness="0"
                Background="Transparent"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                AutomationProperties.AutomationId="Library.Tree"
                AutomationProperties.Name="{x:Static res:Strings.Library_Tree}" />

      <GridSplitter Grid.Row="2"
                    Style="{StaticResource SC_Splitter}"
                    AutomationProperties.AutomationId="Library.Splitter" />

      <!-- The selected dataset: its details and actions. -->
      <ScrollViewer Grid.Row="3"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Focusable="False"
                    AutomationProperties.AutomationId="Library.Details"
                    AutomationProperties.Name="{x:Static res:Strings.Library_Details}">
        <StackPanel Margin="0,8,0,0">
          <TextBlock Text="{x:Static res:Strings.Library_SelectItemPlaceholder}"
                     Style="{StaticResource SC_Caption}"
                     Visibility="{Binding ShowPlaceholder, Converter={StaticResource BooleanToVisibility}}" />

          <StackPanel DataContext="{Binding Details}"
                      Visibility="{Binding DataContext.HasDetails, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibility}}">
            <DockPanel>
              <ContentControl DockPanel.Dock="Left"
                              Content="{Binding DataContext.SelectedNode.ProductTag, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Style="{StaticResource OptionalProductTag}" />
              <TextBlock Text="{Binding Name}" Style="{StaticResource DatasetTitle}" />
            </DockPanel>
            <TextBlock Text="{Binding Product}" Style="{StaticResource SC_OptionalCaption}" Margin="0,2,0,0" />

            <!-- Add to Map and Show Footprint; the rest in the ≡ menu (§10 decision 6). -->
            <WrapPanel Margin="0,8,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
              <Button Content="{x:Static res:Strings.Library_AddToMap}"
                      ToolTip="{x:Static res:Strings.Tooltip_LibraryAddToMap}"
                      Command="{Binding AddToMapCommand}"
                      Style="{DynamicResource Esri_Button}"
                      AutomationProperties.AutomationId="Library.AddToMap"
                      AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddToMap}" />
              <Button Content="{x:Static res:Strings.Library_ShowFootprint}"
                      ToolTip="{x:Static res:Strings.Tooltip_LibraryShowFootprint}"
                      Command="{Binding ShowFootprintCommand}"
                      Style="{DynamicResource Esri_Button}"
                      Margin="{StaticResource SC_ButtonGap}"
                      AutomationProperties.AutomationId="Library.ShowFootprint"
                      AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryShowFootprint}" />
              <Button Style="{StaticResource SC_BurgerButton}"
                      Margin="{StaticResource SC_ButtonGap}"
                      ToolTip="{x:Static res:Strings.Tooltip_LibraryDatasetMore}"
                      AutomationProperties.Name="{x:Static res:Strings.Tooltip_LibraryDatasetMore}"
                      AutomationProperties.AutomationId="Library.DatasetMore">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{x:Static res:Strings.Library_AddFeatureLayers}"
                              ToolTip="{x:Static res:Strings.Tooltip_LibraryAddFeatureLayers}"
                              Command="{Binding AddFeatureLayersCommand}"
                              AutomationProperties.AutomationId="Library.AddFeatureLayers"
                              AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddFeatureLayers}" />
                    <MenuItem Header="{x:Static res:Strings.Library_Validate}"
                              ToolTip="{x:Static res:Strings.Tooltip_LibraryValidate}"
                              Command="{Binding ValidateCommand}"
                              AutomationProperties.AutomationId="Library.Validate"
                              AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryValidate}" />
                    <MenuItem Header="{x:Static res:Strings.Library_OpenContainingFolder}"
                              ToolTip="{x:Static res:Strings.Tooltip_LibraryOpenContainingFolder}"
                              Command="{Binding OpenContainingFolderCommand}"
                              AutomationProperties.AutomationId="Library.OpenContainingFolder"
                              AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryOpenContainingFolder}" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </WrapPanel>

            <!-- Only where the producer marks the data (brief §7.1). -->
            <ContentControl Content="{x:Static res:Strings.Library_NotForNavigationStrip}"
                            ToolTip="{x:Static res:Strings.Library_NotForNavigationToolTip}"
                            Style="{StaticResource SC_CautionStrip}"
                            Margin="0,8,0,0"
                            Visibility="{Binding NotForNavigation, Converter={StaticResource BooleanToVisibility}}"
                            AutomationProperties.AutomationId="Library.NotForNavigation"
                            AutomationProperties.Name="{x:Static res:Strings.Library_NotForNavigation}"
                            AutomationProperties.HelpText="{x:Static res:Strings.Library_NotForNavigationToolTip}" />

            <!-- One label column across the groups. -->
            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" Grid.IsSharedSizeScope="True">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <ContentControl Content="{Binding Header}" Style="{StaticResource SC_SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding Fields}" Style="{StaticResource SC_FieldGrid}" Grid.IsSharedSizeScope="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="{StaticResource SC_FieldRowMargin}">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" SharedSizeGroup="SC_FieldLabel" MaxWidth="200" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource SC_FieldLabel}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Value, Mode=OneWay}"
                                     Style="{StaticResource SC_FieldValue}"
                                     AutomationProperties.Name="{Binding Label}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- The empty Library: what it's for, how to add to it, and where to drop. -->
    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}"
                  AutomationProperties.AutomationId="Library.Empty">
      <StackPanel VerticalAlignment="Center" Margin="{StaticResource SC_PaneGutter}">
        <HeaderedContentControl Style="{StaticResource SC_EmptyState}"
                                sc:Ui.Glyph="{StaticResource SC_GlyphLibrary}"
                                Header="{x:Static res:Strings.Library_EmptyTitle}"
                                Content="{x:Static res:Strings.Library_EmptyDescription}">
          <sc:Ui.Actions>
            <StackPanel>
              <Button Content="{x:Static res:Strings.Library_AddFolder}"
                      ToolTip="{x:Static res:Strings.Tooltip_LibraryAddFolder}"
                      Command="{Binding AddFolderCommand}"
                      Style="{DynamicResource Esri_Button}"
                      AutomationProperties.AutomationId="Library.Empty.AddFolder"
                      AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddFolder}" />
              <Button Content="{x:Static res:Strings.Library_AddExchangeSet}"
                      ToolTip="{x:Static res:Strings.Tooltip_LibraryAddExchangeSet}"
                      Command="{Binding AddExchangeSetCommand}"
                      Style="{DynamicResource Esri_Button}"
                      Margin="0,8,0,0"
                      AutomationProperties.AutomationId="Library.Empty.AddExchangeSet"
                      AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddExchangeSet}" />
              <Button Content="{x:Static res:Strings.Library_AddManifest}"
                      ToolTip="{x:Static res:Strings.Tooltip_LibraryAddManifest}"
                      Command="{Binding AddManifestCommand}"
                      Style="{DynamicResource Esri_Button}"
                      Margin="0,8,0,0"
                      AutomationProperties.AutomationId="Library.Empty.AddManifest"
                      AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddManifest}" />
            </StackPanel>
          </sc:Ui.Actions>
        </HeaderedContentControl>

        <!-- The drop zone: dashed, and the accent colour while something is dragged over the pane. -->
        <Grid Margin="0,8,0,0">
          <Rectangle x:Name="DropZoneEdge"
                     Stroke="{DynamicResource SC_TagBorderBrush}"
                     StrokeThickness="1"
                     StrokeDashArray="4 3"
                     RadiusX="2"
                     RadiusY="2"
                     SnapsToDevicePixels="True" />
          <TextBlock Text="{x:Static res:Strings.Library_DropHint}"
                     Style="{StaticResource SC_Caption}"
                     TextAlignment="Center"
                     Margin="12" />
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <ContentControl Grid.Row="2"
                    Content="{x:Static res:Strings.Library_NotForNavigation}"
                    Style="{StaticResource SC_PaneFooter}"
                    AutomationProperties.AutomationId="Library.Footer" />
  </Grid>
</UserControl>
