<UserControl x:Class="EncDotNet.SoundCharts.LibraryPaneView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:library="clr-namespace:EncDotNet.SoundCharts.Library"
             xmlns:res="clr-namespace:EncDotNet.SoundCharts.Resources"
             AllowDrop="True"
             DragEnter="OnDragOver"
             DragOver="OnDragOver"
             Drop="OnDrop"
             AutomationProperties.AutomationId="Library">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

      <!-- Text that collapses when it has nothing to say. Not based on Pro's
           Esri_TextBlockRegular: BasedOn needs a static resource, which the
           pane can't count on finding at load time. -->
      <Style x:Key="OptionalText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleSubduedBrush}" />
        <Style.Triggers>
          <Trigger Property="Text" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed" />
          </Trigger>
          <Trigger Property="Text" Value="">
            <Setter Property="Visibility" Value="Collapsed" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,10,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleSubduedBrush}" />
      </Style>

      <!-- One row of the tree: a collection, a source or a dataset. -->
      <HierarchicalDataTemplate DataType="{x:Type library:LibraryNode}" ItemsSource="{Binding Children}">
        <StackPanel Margin="0,1" AutomationProperties.Name="{Binding Title}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource Esri_TextBlockRegular}" />
            <TextBlock Text="{Binding Badge}"
                       Margin="8,0,0,0"
                       FontFamily="Consolas"
                       Style="{StaticResource OptionalText}" />
            <ItemsControl ItemsSource="{Binding Tags}" Focusable="False" Margin="4,0,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderThickness="1"
                          BorderBrush="{DynamicResource Esri_BorderBrush}"
                          Padding="4,0"
                          Margin="4,0,0,0">
                    <TextBlock Text="{Binding}" Foreground="{DynamicResource Esri_TextStyleDefaultBrush}" FontSize="11" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Esri_TextErrorBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </HierarchicalDataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="80" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="80" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Add to the Library, refresh, remove. -->
    <WrapPanel Grid.Row="0" Margin="0,0,0,6">
      <Button Content="{x:Static res:Strings.Library_AddFolder}"
              ToolTip="{x:Static res:Strings.Tooltip_LibraryAddFolder}"
              Command="{Binding AddFolderCommand}"
              Style="{DynamicResource Esri_Button}"
              Margin="0,0,4,4"
              AutomationProperties.AutomationId="Library.AddFolder"
              AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddFolder}" />
      <Button Content="{x:Static res:Strings.Library_AddExchangeSet}"
              ToolTip="{x:Static res:Strings.Tooltip_LibraryAddExchangeSet}"
              Command="{Binding AddExchangeSetCommand}"
              Style="{DynamicResource Esri_Button}"
              Margin="0,0,4,4"
              AutomationProperties.AutomationId="Library.AddExchangeSet"
              AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddExchangeSet}" />
      <Button Content="{x:Static res:Strings.Library_AddManifest}"
              ToolTip="{x:Static res:Strings.Tooltip_LibraryAddManifest}"
              Command="{Binding AddManifestCommand}"
              Style="{DynamicResource Esri_Button}"
              Margin="0,0,4,4"
              AutomationProperties.AutomationId="Library.AddManifest"
              AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddManifest}" />
      <Button Content="{x:Static res:Strings.Library_Refresh}"
              ToolTip="{x:Static res:Strings.Tooltip_LibraryRefresh}"
              Command="{Binding RefreshCommand}"
              Style="{DynamicResource Esri_Button}"
              Margin="0,0,4,4"
              AutomationProperties.AutomationId="Library.Refresh"
              AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryRefresh}" />
      <Button Content="{x:Static res:Strings.Library_Remove}"
              ToolTip="{x:Static res:Strings.Tooltip_LibraryRemove}"
              Command="{Binding RemoveCommand}"
              Style="{DynamicResource Esri_Button}"
              Margin="0,0,4,4"
              AutomationProperties.AutomationId="Library.Remove"
              AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryRemove}" />
    </WrapPanel>

    <!-- The viewer's filter. -->
    <Grid Grid.Row="1" Margin="0,0,0,6">
      <TextBox x:Name="Filter"
               Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
               AutomationProperties.AutomationId="Library.Filter"
               AutomationProperties.Name="{x:Static res:Strings.Library_Filter}" />
      <TextBlock Text="{x:Static res:Strings.Library_FilterWatermark}"
                 Margin="6,0,0,0"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False"
                 Foreground="{DynamicResource Esri_TextStyleSubduedBrush}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Text, ElementName=Filter}" Value="">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <!-- Collections, sources and datasets. -->
    <TreeView x:Name="Tree"
              Grid.Row="2"
              ItemsSource="{Binding Nodes}"
              SelectedItemChanged="OnSelectedItemChanged"
              BorderThickness="0"
              Background="Transparent"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              AutomationProperties.AutomationId="Library.Tree"
              AutomationProperties.Name="{x:Static res:Strings.Library_Tree}" />

    <!-- The empty Library: what it's for, and how to add to it. -->
    <StackPanel Grid.Row="2"
                VerticalAlignment="Center"
                Margin="8"
                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}"
                AutomationProperties.AutomationId="Library.Empty">
      <TextBlock Text="{x:Static res:Strings.Library_EmptyTitle}"
                 Style="{DynamicResource Esri_TextBlockH5}"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Center" />
      <TextBlock Text="{x:Static res:Strings.Library_EmptyDescription}"
                 Style="{DynamicResource Esri_TextBlockRegular}"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 Margin="0,6,0,0" />
      <TextBlock Text="{x:Static res:Strings.Library_DropHint}"
                 Style="{StaticResource OptionalText}"
                 TextAlignment="Center"
                 Margin="0,6,0,0" />
    </StackPanel>

    <GridSplitter Grid.Row="3"
                  Height="5"
                  HorizontalAlignment="Stretch"
                  Background="{DynamicResource Esri_BorderBrush}"
                  AutomationProperties.AutomationId="Library.Splitter" />

    <!-- The selected dataset: its details and actions. -->
    <ScrollViewer Grid.Row="4"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  AutomationProperties.AutomationId="Library.Details"
                  AutomationProperties.Name="{x:Static res:Strings.Library_Details}">
      <StackPanel Margin="0,6,0,0">
        <TextBlock Text="{x:Static res:Strings.Library_SelectItemPlaceholder}"
                   Style="{DynamicResource Esri_TextBlockRegular}"
                   Foreground="{DynamicResource Esri_TextStyleSubduedBrush}"
                   Visibility="{Binding ShowPlaceholder, Converter={StaticResource BooleanToVisibility}}" />

        <StackPanel DataContext="{Binding Details}"
                    Visibility="{Binding DataContext.HasDetails, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Text="{Binding Name}" Style="{DynamicResource Esri_TextBlockH5}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Product}" Style="{StaticResource OptionalText}" />

          <Border BorderThickness="1"
                  BorderBrush="{DynamicResource Esri_BorderBrush}"
                  Padding="6,3"
                  Margin="0,6,0,0"
                  HorizontalAlignment="Left"
                  Visibility="{Binding NotForNavigation, Converter={StaticResource BooleanToVisibility}}"
                  AutomationProperties.AutomationId="Library.NotForNavigation">
            <TextBlock Text="{x:Static res:Strings.Library_NotForNavigation}"
                       Style="{DynamicResource Esri_TextBlockRegular}"
                       FontWeight="Bold" />
          </Border>

          <!-- Add to Map, Add as Feature Layers (#15), Show Footprint, Validate, Open Containing Folder (D9). -->
          <WrapPanel Margin="0,8,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Button Content="{x:Static res:Strings.Library_AddToMap}"
                    ToolTip="{x:Static res:Strings.Tooltip_LibraryAddToMap}"
                    Command="{Binding AddToMapCommand}"
                    Style="{DynamicResource Esri_Button}"
                    Margin="0,0,4,4"
                    AutomationProperties.AutomationId="Library.AddToMap"
                    AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddToMap}" />
            <Button Content="{x:Static res:Strings.Library_AddFeatureLayers}"
                    ToolTip="{x:Static res:Strings.Tooltip_LibraryAddFeatureLayers}"
                    Command="{Binding AddFeatureLayersCommand}"
                    Style="{DynamicResource Esri_Button}"
                    Margin="0,0,4,4"
                    AutomationProperties.AutomationId="Library.AddFeatureLayers"
                    AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddFeatureLayers}" />
            <Button Content="{x:Static res:Strings.Library_ShowFootprint}"
                    ToolTip="{x:Static res:Strings.Tooltip_LibraryShowFootprint}"
                    Command="{Binding ShowFootprintCommand}"
                    Style="{DynamicResource Esri_Button}"
                    Margin="0,0,4,4"
                    AutomationProperties.AutomationId="Library.ShowFootprint"
                    AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryShowFootprint}" />
            <Button Content="{x:Static res:Strings.Library_Validate}"
                    ToolTip="{x:Static res:Strings.Tooltip_LibraryValidate}"
                    Command="{Binding ValidateCommand}"
                    Style="{DynamicResource Esri_Button}"
                    Margin="0,0,4,4"
                    AutomationProperties.AutomationId="Library.Validate"
                    AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryValidate}" />
            <Button Content="{x:Static res:Strings.Library_OpenContainingFolder}"
                    ToolTip="{x:Static res:Strings.Tooltip_LibraryOpenContainingFolder}"
                    Command="{Binding OpenContainingFolderCommand}"
                    Style="{DynamicResource Esri_Button}"
                    Margin="0,0,4,4"
                    AutomationProperties.AutomationId="Library.OpenContainingFolder"
                    AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryOpenContainingFolder}" />
          </WrapPanel>

          <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Header}" Style="{StaticResource SectionHeading}" />
                  <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,1">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" MaxWidth="200" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Label}"
                                     Style="{DynamicResource Esri_TextBlockRegular}"
                                     Foreground="{DynamicResource Esri_TextStyleSubduedBrush}"
                                     TextWrapping="Wrap"
                                     Margin="0,0,12,0" />
                          <!-- A read-only text box so the value can be selected and copied. -->
                          <TextBox Grid.Column="1"
                                   Text="{Binding Value, Mode=OneWay}"
                                   IsReadOnly="True"
                                   BorderThickness="0"
                                   Background="Transparent"
                                   Foreground="{DynamicResource Esri_TextStyleDefaultBrush}"
                                   Padding="0"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding Label}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="5"
               Text="{x:Static res:Strings.Library_NotForNavigation}"
               Margin="0,6,0,0"
               Style="{StaticResource OptionalText}"
               AutomationProperties.AutomationId="Library.Footer" />
  </Grid>
</UserControl>
