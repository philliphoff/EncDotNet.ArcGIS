<UserControl x:Class="EncDotNet.SoundCharts.LibraryPaneView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
             xmlns:library="clr-namespace:EncDotNet.SoundCharts.Library"
             xmlns:res="clr-namespace:EncDotNet.SoundCharts.Resources"
             xmlns:sc="clr-namespace:EncDotNet.SoundCharts.Themes"
             AllowDrop="True"
             DragEnter="OnDragOver"
             DragOver="OnDragOver"
             DragLeave="OnDragLeave"
             Drop="OnDrop"
             AutomationProperties.AutomationId="Library">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml" />
        <sc:SoundChartsTheme />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

      <!-- The details header's buttons: 24 px like everything else in the
           pane (design §4.1), glyph then label, as the mockup. -->
      <Thickness x:Key="DetailsButtonPadding">8,0</Thickness>

      <!-- A dataset's tag: neutral, or a warning chip with its glyph (Missing). -->
      <Style x:Key="TagChip" TargetType="ContentControl" BasedOn="{StaticResource SC_Chip}">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsWarning}" Value="True">
            <Setter Property="sc:Tone.Value" Value="Warning" />
            <Setter Property="sc:Ui.Glyph" Value="{StaticResource SC_GlyphCheck}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- A row's detail after the name (a dataset's title, a source's
           location, a status): subdued, in the warning colour for a problem. -->
      <Style x:Key="RowDetail" TargetType="Run">
        <Setter Property="FontSize" Value="{StaticResource SC_FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleSubduedBrush}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsWarning}" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource SC_WarningBrush}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- The tree's twisty: a 16 px chevron, right when collapsed, down when expanded. -->
      <Style x:Key="TreeTwisty" TargetType="ToggleButton">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleSubduedBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border Background="Transparent">
                <Path x:Name="Chevron"
                      Style="{StaticResource SC_GlyphSmall}"
                      Data="{StaticResource SC_GlyphChevronRight}"
                      HorizontalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Chevron" Property="Data" Value="{StaticResource SC_GlyphChevronDown}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleDefaultBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- A tree row (design §6): 24 px, full width, so the count or edition
           lines up at the right edge on every row. Indented 16 px a level by
           the row's kind; rows without children keep the twisty's space, so
           tags line up. Hover and selection fill the whole row. -->
      <Style x:Key="TreeRow" TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Padding" Value="4,0,8,0" />
        <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleDefaultBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="ToolTip" Value="{Binding Detail}" />
        <!-- The selection fill shows focus; the default dotted rectangle would
             wrap the row and all its children. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TreeViewItem">
              <StackPanel>
                <Border x:Name="Row"
                        MinHeight="{StaticResource SC_RowHeight}"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        SnapsToDevicePixels="True">
                  <DockPanel>
                    <ToggleButton x:Name="Twisty"
                                  DockPanel.Dock="Left"
                                  Style="{StaticResource TreeTwisty}"
                                  Margin="0,0,4,0"
                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                    <ContentPresenter x:Name="PART_Header"
                                      ContentSource="Header"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch" />
                  </DockPanel>
                </Border>
                <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                  <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="HasItems" Value="False">
                  <Setter TargetName="Twisty" Property="Visibility" Value="Hidden" />
                </Trigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{DynamicResource Esri_BackgroundHoverSelectedBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{DynamicResource Esri_BackgroundSelectedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Kind}" Value="{x:Static library:LibraryNodeKind.Source}">
            <Setter Property="Padding" Value="20,0,8,0" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Kind}" Value="{x:Static library:LibraryNodeKind.Dataset}">
            <Setter Property="Padding" Value="36,0,8,0" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- A detail's status chip (Validation, Compatibility; design §6): the
           tone's glyph and word, collapsed for a plain value. -->
      <Style x:Key="StatusChip" TargetType="ContentControl" BasedOn="{StaticResource SC_Chip}">
        <Setter Property="sc:Tone.Value" Value="{Binding Tone}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Chip}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="Success">
            <Setter Property="sc:Ui.Glyph" Value="{StaticResource SC_GlyphSuccess}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="Warning">
            <Setter Property="sc:Ui.Glyph" Value="{StaticResource SC_GlyphCheck}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="Danger">
            <Setter Property="sc:Ui.Glyph" Value="{StaticResource SC_GlyphError}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- A detail's value, or the note under its chip; collapsed when there's none. -->
      <Style x:Key="DetailValue" TargetType="TextBox" BasedOn="{StaticResource SC_FieldValue}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding Value}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Shown while the Library has collections; the empty state replaces it. -->
      <Style x:Key="ShownWithCollections" TargetType="FrameworkElement">
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsEmpty}" Value="True">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- One row of the tree: a collection, a source or a dataset. One line:
           glyph or product tag, the name and its detail (trimmed; the whole
           detail is the row's tooltip), then the count or edition and the
           tags at the right edge. -->
      <HierarchicalDataTemplate DataType="{x:Type library:LibraryNode}" ItemsSource="{Binding Children}">
        <DockPanel>
          <Path DockPanel.Dock="Left"
                Data="{StaticResource SC_GlyphLibrary}"
                TextElement.Foreground="{DynamicResource Esri_TextStyleSubduedBrush}"
                Margin="0,0,4,0">
            <Path.Style>
              <Style TargetType="Path" BasedOn="{StaticResource SC_Glyph}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="{x:Static library:LibraryNodeKind.Collection}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Path.Style>
          </Path>
          <ContentControl DockPanel.Dock="Left" Content="{Binding ProductTag}" Style="{StaticResource SC_OptionalProductTag}" Margin="0,0,6,0" />
          <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Tags}" Focusable="False" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ContentControl Content="{Binding Text}" Style="{StaticResource TagChip}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock DockPanel.Dock="Right"
                     Text="{Binding Meta}"
                     Style="{StaticResource SC_OptionalMono}"
                     FontSize="{StaticResource SC_FontSizeTag}"
                     TextWrapping="NoWrap"
                     VerticalAlignment="Center"
                     Margin="8,0,0,0" />
          <Path DockPanel.Dock="Left"
                Data="{StaticResource SC_GlyphCheck}"
                TextElement.Foreground="{DynamicResource SC_WarningBrush}"
                Margin="0,0,4,0">
            <Path.Style>
              <Style TargetType="Path" BasedOn="{StaticResource SC_GlyphSmall}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsWarning}" Value="True" />
                      <Condition Binding="{Binding HasDetail}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Path.Style>
          </Path>
          <TextBlock Style="{StaticResource SC_Body}"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"><Run Text="{Binding Title, Mode=OneWay}" /><Run Text="{Binding Detail, Mode=OneWay, StringFormat='  {0}'}" Style="{StaticResource RowDetail}" /></TextBlock>
        </DockPanel>
      </HierarchicalDataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Add to the Library on the left; refresh, remove and the ≡ menu on the right. -->
    <Border Grid.Row="0" Style="{StaticResource SC_PaneToolbar}">
      <DockPanel LastChildFill="False">
        <Button Style="{StaticResource SC_ToolbarMenuButton}"
                sc:Ui.Glyph="{StaticResource SC_GlyphAdd}"
                Content="{x:Static res:Strings.Library_Add}"
                ToolTip="{x:Static res:Strings.Tooltip_LibraryAdd}"
                AutomationProperties.AutomationId="Library.Add"
                AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAdd}">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static res:Strings.Library_AddFolder}"
                        ToolTip="{x:Static res:Strings.Tooltip_LibraryAddFolder}"
                        Command="{Binding AddFolderCommand}"
                        AutomationProperties.AutomationId="Library.AddFolder"
                        AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddFolder}" />
              <MenuItem Header="{x:Static res:Strings.Library_AddExchangeSet}"
                        ToolTip="{x:Static res:Strings.Tooltip_LibraryAddExchangeSet}"
                        Command="{Binding AddExchangeSetCommand}"
                        AutomationProperties.AutomationId="Library.AddExchangeSet"
                        AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddExchangeSet}" />
              <MenuItem Header="{x:Static res:Strings.Library_AddManifest}"
                        ToolTip="{x:Static res:Strings.Tooltip_LibraryAddManifest}"
                        Command="{Binding AddManifestCommand}"
                        AutomationProperties.AutomationId="Library.AddManifest"
                        AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddManifest}" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>

        <!-- Docked right in reverse order: ≡ at the far right. -->
        <Button DockPanel.Dock="Right"
                Style="{StaticResource SC_BurgerButton}"
                Margin="{StaticResource SC_ToolbarItemGap}"
                ToolTip="{x:Static res:Strings.Tooltip_LibraryMore}"
                AutomationProperties.Name="{x:Static res:Strings.Tooltip_LibraryMore}"
                AutomationProperties.AutomationId="Library.More">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static res:Strings.Library_AddFolder}" ToolTip="{x:Static res:Strings.Tooltip_LibraryAddFolder}" Command="{Binding AddFolderCommand}" />
              <MenuItem Header="{x:Static res:Strings.Library_AddExchangeSet}" ToolTip="{x:Static res:Strings.Tooltip_LibraryAddExchangeSet}" Command="{Binding AddExchangeSetCommand}" />
              <MenuItem Header="{x:Static res:Strings.Library_AddManifest}" ToolTip="{x:Static res:Strings.Tooltip_LibraryAddManifest}" Command="{Binding AddManifestCommand}" />
              <Separator />
              <MenuItem Header="{x:Static res:Strings.Library_AddInView}"
                        ToolTip="{x:Static res:Strings.Tooltip_LibraryAddAllInView}"
                        Command="{Binding AddLibraryInViewCommand}"
                        AutomationProperties.AutomationId="Library.AddAllInView"
                        AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddAllInView}" />
              <Separator />
              <MenuItem Header="{x:Static res:Strings.Library_Refresh}" ToolTip="{x:Static res:Strings.Tooltip_LibraryRefresh}" Command="{Binding RefreshCommand}" />
              <MenuItem Header="{x:Static res:Strings.Library_Remove}" ToolTip="{x:Static res:Strings.Tooltip_LibraryRemove}" Command="{Binding RemoveCommand}" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button DockPanel.Dock="Right"
                Style="{StaticResource SC_IconButton}"
                sc:Ui.Glyph="{StaticResource SC_GlyphClose}"
                Margin="{StaticResource SC_ToolbarItemGap}"
                Command="{Binding RemoveCommand}"
                ToolTip="{x:Static res:Strings.Tooltip_LibraryRemove}"
                AutomationProperties.Name="{x:Static res:Strings.Library_Remove}"
                AutomationProperties.AutomationId="Library.Remove"
                AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryRemove}" />
        <Button DockPanel.Dock="Right"
                Style="{StaticResource SC_IconButton}"
                sc:Ui.Glyph="{StaticResource SC_GlyphRefresh}"
                Command="{Binding RefreshCommand}"
                ToolTip="{x:Static res:Strings.Tooltip_LibraryRefresh}"
                AutomationProperties.Name="{x:Static res:Strings.Library_Refresh}"
                AutomationProperties.AutomationId="Library.Refresh"
                AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryRefresh}" />
      </DockPanel>
    </Border>

    <!-- The Library's collections: search, tree and the selected dataset's details. -->
    <Grid Grid.Row="1" Margin="{StaticResource SC_PaneGutter}" Style="{StaticResource ShownWithCollections}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="80" />
        <RowDefinition Height="Auto" />
        <!-- Room for the sticky header and its buttons at least. -->
        <RowDefinition Height="*" MinHeight="120" />
      </Grid.RowDefinitions>

      <!-- The viewer's filter. -->
      <controls:SearchTextBox x:Name="Filter"
                              Grid.Row="0"
                              Margin="0,0,0,8"
                              Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                              InfoText="{x:Static res:Strings.Library_FilterWatermark}"
                              AutomationProperties.AutomationId="Library.Filter"
                              AutomationProperties.Name="{x:Static res:Strings.Library_Filter}" />

      <!-- Collections, sources and datasets. -->
      <TreeView x:Name="Tree"
                Grid.Row="1"
                ItemsSource="{Binding Nodes}"
                ItemContainerStyle="{StaticResource TreeRow}"
                SelectedItemChanged="OnSelectedItemChanged"
                BorderThickness="0"
                Background="Transparent"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                AutomationProperties.AutomationId="Library.Tree"
                AutomationProperties.Name="{x:Static res:Strings.Library_Tree}" />

      <GridSplitter Grid.Row="2"
                    Style="{StaticResource SC_Splitter}"
                    AutomationProperties.AutomationId="Library.Splitter" />

      <!-- The selection's header and actions stay put; only the dataset's
           properties scroll under them. -->
      <Grid Grid.Row="3" Margin="0,8,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
          <TextBlock Text="{x:Static res:Strings.Library_SelectItemPlaceholder}"
                     Style="{StaticResource SC_Caption}"
                     Visibility="{Binding ShowPlaceholder, Converter={StaticResource BooleanToVisibility}}" />

          <!-- A collection or source: its name, how many datasets, and Add All to Map. -->
          <StackPanel Visibility="{Binding HasGroup, Converter={StaticResource BooleanToVisibility}}">
            <DockPanel>
              <ContentControl DockPanel.Dock="Left"
                              Content="{Binding SelectedNode.ProductTag}"
                              Style="{StaticResource SC_OptionalProductTag}"
                              Margin="0,0,4,0" />
              <TextBlock Text="{Binding SelectedNode.Title}" Style="{StaticResource SC_Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding GroupSummary}" Style="{StaticResource SC_OptionalCaption}" Margin="0,2,0,0" />
            <WrapPanel Margin="0,8,0,0">
              <Button ToolTip="{x:Static res:Strings.Tooltip_LibraryAddAllToMap}"
                      Command="{Binding AddAllToMapCommand}"
                      Style="{DynamicResource Esri_Button}"
                      Height="{StaticResource SC_ControlHeight}"
                      MinWidth="0"
                      Padding="{StaticResource DetailsButtonPadding}"
                      AutomationProperties.Name="{x:Static res:Strings.Library_AddAllToMap}"
                      AutomationProperties.AutomationId="Library.AddAllToMap"
                      AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddAllToMap}">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource SC_Glyph}" Data="{StaticResource SC_GlyphAdd}" Margin="0,0,4,0" />
                  <TextBlock Text="{x:Static res:Strings.Library_AddAllToMap}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button ToolTip="{x:Static res:Strings.Tooltip_LibraryAddInView}"
                      Command="{Binding AddGroupInViewCommand}"
                      Style="{DynamicResource Esri_Button}"
                      Height="{StaticResource SC_ControlHeight}"
                      MinWidth="0"
                      Padding="{StaticResource DetailsButtonPadding}"
                      Margin="{StaticResource SC_ButtonGap}"
                      AutomationProperties.Name="{x:Static res:Strings.Library_AddInView}"
                      AutomationProperties.AutomationId="Library.AddInView"
                      AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddInView}">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource SC_Glyph}" Data="{StaticResource SC_GlyphZoomTo}" Margin="0,0,4,0" />
                  <TextBlock Text="{x:Static res:Strings.Library_AddInView}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>

          <StackPanel DataContext="{Binding Details}"
                      Visibility="{Binding DataContext.HasDetails, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibility}}">
            <DockPanel>
              <ContentControl DockPanel.Dock="Left"
                              Content="{Binding DataContext.SelectedNode.ProductTag, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Style="{StaticResource SC_OptionalProductTag}"
                              Margin="0,0,4,0" />
              <TextBlock Text="{Binding Name}" Style="{StaticResource SC_MonoTitle}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding Product}" Style="{StaticResource SC_OptionalCaption}" Margin="0,2,0,0" />

            <!-- Add to Map and Show Footprint; the rest in the ≡ menu (§10 decision 6). -->
            <WrapPanel Margin="0,8,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
              <Button ToolTip="{x:Static res:Strings.Tooltip_LibraryAddToMap}"
                      Command="{Binding AddToMapCommand}"
                      Style="{DynamicResource Esri_Button}"
                      Height="{StaticResource SC_ControlHeight}"
                      MinWidth="0"
                      Padding="{StaticResource DetailsButtonPadding}"
                      AutomationProperties.Name="{x:Static res:Strings.Library_AddToMap}"
                      AutomationProperties.AutomationId="Library.AddToMap"
                      AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddToMap}">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource SC_Glyph}" Data="{StaticResource SC_GlyphAdd}" Margin="0,0,4,0" />
                  <TextBlock Text="{x:Static res:Strings.Library_AddToMap}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button ToolTip="{x:Static res:Strings.Tooltip_LibraryShowFootprint}"
                      Command="{Binding ShowFootprintCommand}"
                      Style="{DynamicResource Esri_Button}"
                      Height="{StaticResource SC_ControlHeight}"
                      MinWidth="0"
                      Padding="{StaticResource DetailsButtonPadding}"
                      Margin="{StaticResource SC_ButtonGap}"
                      AutomationProperties.Name="{x:Static res:Strings.Library_ShowFootprint}"
                      AutomationProperties.AutomationId="Library.ShowFootprint"
                      AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryShowFootprint}">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource SC_Glyph}" Data="{StaticResource SC_GlyphFootprint}" Margin="0,0,4,0" />
                  <TextBlock Text="{x:Static res:Strings.Library_ShowFootprint}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <!-- A bordered ≡ the same height as the buttons beside it (the
                   mockup's details header), not the toolbar's borderless one. -->
              <Button Style="{DynamicResource Esri_Button}"
                      sc:Ui.OpensContextMenu="True"
                      Height="{StaticResource SC_ControlHeight}"
                      MinWidth="0"
                      Width="28"
                      Padding="0"
                      Margin="{StaticResource SC_ButtonGap}"
                      ToolTip="{x:Static res:Strings.Tooltip_LibraryDatasetMore}"
                      AutomationProperties.Name="{x:Static res:Strings.Tooltip_LibraryDatasetMore}"
                      AutomationProperties.AutomationId="Library.DatasetMore">
                <Path Style="{StaticResource SC_Glyph}" Data="{StaticResource SC_GlyphBurger}" />
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{x:Static res:Strings.Library_AddFeatureLayers}"
                              ToolTip="{x:Static res:Strings.Tooltip_LibraryAddFeatureLayers}"
                              Command="{Binding AddFeatureLayersCommand}"
                              AutomationProperties.AutomationId="Library.AddFeatureLayers"
                              AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddFeatureLayers}" />
                    <MenuItem Header="{x:Static res:Strings.Library_Validate}"
                              ToolTip="{x:Static res:Strings.Tooltip_LibraryValidate}"
                              Command="{Binding ValidateCommand}"
                              AutomationProperties.AutomationId="Library.Validate"
                              AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryValidate}" />
                    <MenuItem Header="{x:Static res:Strings.Library_OpenContainingFolder}"
                              ToolTip="{x:Static res:Strings.Tooltip_LibraryOpenContainingFolder}"
                              Command="{Binding OpenContainingFolderCommand}"
                              AutomationProperties.AutomationId="Library.OpenContainingFolder"
                              AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryOpenContainingFolder}" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </WrapPanel>

            <!-- Only where the producer marks the data (brief §7.1). -->
            <ContentControl Content="{x:Static res:Strings.Library_NotForNavigationStrip}"
                            ToolTip="{x:Static res:Strings.Library_NotForNavigationToolTip}"
                            Style="{StaticResource SC_CautionStrip}"
                            Margin="0,8,0,0"
                            Visibility="{Binding NotForNavigation, Converter={StaticResource BooleanToVisibility}}"
                            AutomationProperties.AutomationId="Library.NotForNavigation"
                            AutomationProperties.Name="{x:Static res:Strings.Library_NotForNavigation}"
                            AutomationProperties.HelpText="{x:Static res:Strings.Library_NotForNavigationToolTip}" />
          </StackPanel>
        </StackPanel>

        <!-- The selected dataset's properties. -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibility}}"
                      AutomationProperties.AutomationId="Library.Details"
                      AutomationProperties.Name="{x:Static res:Strings.Library_Details}">
          <!-- One label column across the groups. -->
          <ItemsControl DataContext="{Binding Details}" ItemsSource="{Binding Groups}" Focusable="False" Grid.IsSharedSizeScope="True" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <ContentControl Content="{Binding Header}" Style="{StaticResource SC_SectionHeader}" />
                  <ItemsControl ItemsSource="{Binding Fields}" Style="{StaticResource SC_FieldGrid}" Grid.IsSharedSizeScope="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="{StaticResource SC_FieldRowMargin}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SC_FieldLabel" MaxWidth="200" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Label}" Style="{StaticResource SC_FieldLabel}" />
                          <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                              <controls:CircularAnimationControl Width="{StaticResource SC_GlyphSizeSmall}"
                                                                 Height="{StaticResource SC_GlyphSizeSmall}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,4,0"
                                                                 Visibility="{Binding IsWorking, Converter={StaticResource BooleanToVisibility}}" />
                              <ContentControl Style="{StaticResource StatusChip}"
                                              Content="{Binding Chip}"
                                              AutomationProperties.Name="{Binding Chip}"
                                              AutomationProperties.HelpText="{Binding Label}" />
                            </StackPanel>
                            <TextBox Text="{Binding Value, Mode=OneWay}"
                                     Style="{StaticResource DetailValue}"
                                     AutomationProperties.Name="{Binding Label}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- The empty Library: what it's for, how to add to it, and where to drop. -->
    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}"
                  AutomationProperties.AutomationId="Library.Empty">
      <StackPanel VerticalAlignment="Center" Margin="{StaticResource SC_PaneGutter}">
        <HeaderedContentControl Style="{StaticResource SC_EmptyState}"
                                sc:Ui.Glyph="{StaticResource SC_GlyphLibrary}"
                                Header="{x:Static res:Strings.Library_EmptyTitle}"
                                Content="{x:Static res:Strings.Library_EmptyDescription}">
          <sc:Ui.Actions>
            <StackPanel>
              <Button Content="{x:Static res:Strings.Library_AddFolder}"
                      ToolTip="{x:Static res:Strings.Tooltip_LibraryAddFolder}"
                      Command="{Binding AddFolderCommand}"
                      Style="{DynamicResource Esri_Button}"
                      AutomationProperties.AutomationId="Library.Empty.AddFolder"
                      AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddFolder}" />
              <Button Content="{x:Static res:Strings.Library_AddExchangeSet}"
                      ToolTip="{x:Static res:Strings.Tooltip_LibraryAddExchangeSet}"
                      Command="{Binding AddExchangeSetCommand}"
                      Style="{DynamicResource Esri_Button}"
                      Margin="0,8,0,0"
                      AutomationProperties.AutomationId="Library.Empty.AddExchangeSet"
                      AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddExchangeSet}" />
              <Button Content="{x:Static res:Strings.Library_AddManifest}"
                      ToolTip="{x:Static res:Strings.Tooltip_LibraryAddManifest}"
                      Command="{Binding AddManifestCommand}"
                      Style="{DynamicResource Esri_Button}"
                      Margin="0,8,0,0"
                      AutomationProperties.AutomationId="Library.Empty.AddManifest"
                      AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_LibraryAddManifest}" />
            </StackPanel>
          </sc:Ui.Actions>
        </HeaderedContentControl>

        <!-- The drop zone: dashed, and the accent colour while something is dragged over the pane. -->
        <ContentControl x:Name="DropZone"
                        Style="{StaticResource SC_DropZone}"
                        Content="{x:Static res:Strings.Library_DropHint}"
                        Margin="0,8,0,0" />
      </StackPanel>
    </ScrollViewer>

    <ContentControl Grid.Row="2"
                    Content="{x:Static res:Strings.Library_NotForNavigation}"
                    Style="{StaticResource SC_PaneFooter}"
                    AutomationProperties.AutomationId="Library.Footer" />
  </Grid>
</UserControl>
