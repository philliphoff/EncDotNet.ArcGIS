<!-- SoundCharts shared theme: sizes, the type ramp, glyphs and the shared
     component styles (look and feel design §4). Views don't merge this file
     directly: they merge one sc:SoundChartsTheme, which merges this and the
     colour dictionary for Pro's theme. The contract, with every key, is
     "Using the theme" in docs/design/look-and-feel.md; update it with any
     change here.

     Rules for this file:
     - SoundCharts brushes (SC_*Brush) live in the sibling colour dictionaries,
       so this file reaches them with DynamicResource only.
     - Esri resources come from Pro at run time, so DynamicResource only, and
       only keys from Esri's published Pro style guide.
     - No hex colours, font families (except SC_MonoFontFamily) or text. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
                    xmlns:sc="clr-namespace:EncDotNet.SoundCharts.Themes">

  <!-- ===================================================================
       Sizes (§4.1 and §4.2)
       =================================================================== -->

  <!-- Type ramp sizes. -->
  <sys:Double x:Key="SC_FontSizePageTitle">16</sys:Double>
  <sys:Double x:Key="SC_FontSizeTitle">14</sys:Double>
  <sys:Double x:Key="SC_FontSizeVerdictTitle">13</sys:Double>
  <sys:Double x:Key="SC_FontSizeBody">12</sys:Double>
  <sys:Double x:Key="SC_FontSizeCaption">11</sys:Double>
  <sys:Double x:Key="SC_FontSizeMono">11.5</sys:Double>
  <sys:Double x:Key="SC_FontSizeTag">10.5</sys:Double>

  <!-- Identifiers, editions, versions, paths, positions and log rows. -->
  <FontFamily x:Key="SC_MonoFontFamily">Cascadia Mono, Consolas</FontFamily>

  <!-- The spacing scale: 2 · 4 · 8 · 12 · 16 · 24. Nothing else. -->
  <sys:Double x:Key="SC_Space2">2</sys:Double>
  <sys:Double x:Key="SC_Space4">4</sys:Double>
  <sys:Double x:Key="SC_Space8">8</sys:Double>
  <sys:Double x:Key="SC_Space12">12</sys:Double>
  <sys:Double x:Key="SC_Space16">16</sys:Double>
  <sys:Double x:Key="SC_Space24">24</sys:Double>

  <!-- Heights and widths. -->
  <sys:Double x:Key="SC_ToolbarHeight">32</sys:Double>
  <sys:Double x:Key="SC_ControlHeight">24</sys:Double>
  <sys:Double x:Key="SC_RowHeight">24</sys:Double>
  <sys:Double x:Key="SC_SummaryRowHeight">22</sys:Double>
  <sys:Double x:Key="SC_ChipHeight">18</sys:Double>
  <sys:Double x:Key="SC_GlyphSize">16</sys:Double>
  <sys:Double x:Key="SC_GlyphSizeSmall">12</sys:Double>
  <sys:Double x:Key="SC_DialogButtonMinWidth">80</sys:Double>
  <sys:Double x:Key="SC_FormInputWidth">96</sys:Double>
  <sys:Double x:Key="SC_FormSliderWidth">170</sys:Double>
  <sys:Double x:Key="SC_EmptyStateTextMaxWidth">300</sys:Double>
  <sys:Double x:Key="SC_StatusLabelMaxWidth">220</sys:Double>

  <!-- Margins and paddings. -->
  <Thickness x:Key="SC_PaneGutter">8</Thickness>
  <Thickness x:Key="SC_DialogPadding">16</Thickness>
  <Thickness x:Key="SC_RowPadding">8,5</Thickness>
  <Thickness x:Key="SC_ButtonGap">8,0,0,0</Thickness>
  <Thickness x:Key="SC_ToolbarItemGap">4,0,0,0</Thickness>
  <Thickness x:Key="SC_FieldRowMargin">0,1,0,2</Thickness>
  <Thickness x:Key="SC_FormRowMargin">0,0,0,8</Thickness>
  <Thickness x:Key="SC_FormGroupMargin">0,0,0,16</Thickness>

  <!-- Grid columns. -->
  <GridLength x:Key="SC_FormLabelColumnDialog">150</GridLength>
  <GridLength x:Key="SC_FormLabelColumnOptions">170</GridLength>
  <GridLength x:Key="SC_SummaryLabelColumn">72</GridLength>

  <!-- ===================================================================
       Glyphs (§4.5): 16 px outline geometries on a 16 x 16 grid, drawn with
       SC_Glyph, SC_GlyphSmall or SC_ToneGlyph, or through sc:Ui.Glyph.
       =================================================================== -->

  <!-- Add (plus) -->
  <Geometry x:Key="SC_GlyphAdd">M 8 2.5 v 11 M 2.5 8 h 11</Geometry>
  <!-- Refresh, check again -->
  <Geometry x:Key="SC_GlyphRefresh">M 13.5 8 A 5.5 5.5 0 1 1 11.8 4 M 12 1.5 V 4.3 H 9.2</Geometry>
  <!-- More (the burger menu) -->
  <Geometry x:Key="SC_GlyphBurger">M 2.5 4 h 11 M 2.5 8 h 11 M 2.5 12 h 11</Geometry>
  <!-- Menu button arrow; expanded section -->
  <Geometry x:Key="SC_GlyphChevronDown">M 4 6 l 4 4 4 -4</Geometry>
  <!-- Collapsed section -->
  <Geometry x:Key="SC_GlyphChevronRight">M 6 4 l 4 4 -4 4</Geometry>
  <!-- Dismiss, clear a filter -->
  <Geometry x:Key="SC_GlyphClose">M 4 4 l 8 8 M 12 4 l -8 8</Geometry>
  <!-- Search -->
  <Geometry x:Key="SC_GlyphSearch">M 2.5 7 A 4.5 4.5 0 1 1 11.5 7 A 4.5 4.5 0 1 1 2.5 7 Z M 10.3 10.3 L 14 14</Geometry>
  <!-- Filter -->
  <Geometry x:Key="SC_GlyphFilter">M 2 3 h 12 l -4.5 5.5 V 13 l -3 -1.5 v -3 z</Geometry>
  <!-- Copy -->
  <Geometry x:Key="SC_GlyphCopy">M 5.5 5.5 H 13.5 V 14.5 H 5.5 Z M 3.5 11.5 h -1 v -10 h 8 v 1</Geometry>
  <!-- Folder, collection -->
  <Geometry x:Key="SC_GlyphFolder">M 1.5 4 V 13 h 13 V 5.5 H 7.5 L 6 4 z</Geometry>
  <!-- Open containing folder, Browse... -->
  <Geometry x:Key="SC_GlyphFolderOpen">M 1.5 13 V 3.5 h 4.5 L 7.5 5 h 5.5 v 2 M 1.5 13 l 2 -6 h 11 l -2 6 z</Geometry>
  <!-- Layers, add as feature layers -->
  <Geometry x:Key="SC_GlyphLayers">M 8 2 l 6 3 -6 3 -6 -3 z M 2 8 l 6 3 6 -3 M 2 11 l 6 3 6 -3</Geometry>
  <!-- Library -->
  <Geometry x:Key="SC_GlyphLibrary">M 2.5 2.5 v 11 h 11 M 4.5 3 H 7 V 11.5 H 4.5 Z M 7.5 5 H 10 V 11.5 H 7.5 Z M 11 4.5 l 2.3 -0.6 1.9 7.2 -2.3 0.6 z</Geometry>
  <!-- Chart, dataset -->
  <Geometry x:Key="SC_GlyphChart">M 1.5 1.5 H 14.5 V 14.5 H 1.5 Z M 1.5 10 l 3 -1.5 3 1 3 -3 4 -1.5 M 1.5 13 l 4 -2 3 0.8 3 -2.8 3 -1</Geometry>
  <!-- Show footprint -->
  <Geometry x:Key="SC_GlyphFootprint">M 2 3.5 h 12 v 9 H 2 z M 8 5.5 a 2 2 0 0 1 2 2 c 0 1.5 -2 3.5 -2 3.5 S 6 9 6 7.5 a 2 2 0 0 1 2 -2 z</Geometry>
  <!-- Validate -->
  <Geometry x:Key="SC_GlyphValidate">M 8 1.5 l 5.5 2 v 4 c 0 3.3 -2.3 5.8 -5.5 7 -3.2 -1.2 -5.5 -3.7 -5.5 -7 v -4 z M 5.5 8 l 1.8 1.8 L 10.8 6.3</Geometry>
  <!-- Zoom to -->
  <Geometry x:Key="SC_GlyphZoomTo">M 1.5 5 V 1.5 H 5 M 11 1.5 h 3.5 V 5 M 14.5 11 v 3.5 H 11 M 5 14.5 H 1.5 V 11 M 5.8 8 A 2.2 2.2 0 1 1 10.2 8 A 2.2 2.2 0 1 1 5.8 8 Z</Geometry>
  <!-- Map time, time note -->
  <Geometry x:Key="SC_GlyphClock">M 1.5 8 A 6.5 6.5 0 1 1 14.5 8 A 6.5 6.5 0 1 1 1.5 8 Z M 8 4.2 V 8 l 2.6 1.6</Geometry>
  <!-- Now -->
  <Geometry x:Key="SC_GlyphNow">M 2.5 9 A 5.5 5.5 0 1 1 13.5 9 A 5.5 5.5 0 1 1 2.5 9 Z M 8 6 v 3 h 2.5 M 6 1.5 h 4</Geometry>
  <!-- Previous data -->
  <Geometry x:Key="SC_GlyphPrevious">M 10 3.5 L 5.5 8 l 4.5 4.5</Geometry>
  <!-- Next data -->
  <Geometry x:Key="SC_GlyphNext">M 6 3.5 l 4.5 4.5 L 6 12.5</Geometry>
  <!-- Go to nearest data -->
  <Geometry x:Key="SC_GlyphNearest">M 2 8 h 12 M 2 5 v 6 M 14 5 v 6 M 7.5 8 A 2 2 0 1 1 11.5 8 A 2 2 0 1 1 7.5 8 Z</Geometry>
  <!-- Object information -->
  <Geometry x:Key="SC_GlyphObjectInfo">M 2 2 l 4.8 11.5 1.6 -4.6 L 13 7.3 z M 9 12 A 3 3 0 1 1 15 12 A 3 3 0 1 1 9 12 Z M 12 11.3 v 2 M 11.45 10.2 A 0.55 0.55 0 1 1 12.55 10.2 A 0.55 0.55 0 1 1 11.45 10.2 Z</Geometry>
  <!-- Route, open route -->
  <Geometry x:Key="SC_GlyphRoute">M 3 13 l 3.5 -5 4 2.5 L 13 3 M 1.6 13 A 1.4 1.4 0 1 1 4.4 13 A 1.4 1.4 0 1 1 1.6 13 Z M 5.1 8 A 1.4 1.4 0 1 1 7.9 8 A 1.4 1.4 0 1 1 5.1 8 Z M 9.1 10.5 A 1.4 1.4 0 1 1 11.9 10.5 A 1.4 1.4 0 1 1 9.1 10.5 Z M 11.6 3 A 1.4 1.4 0 1 1 14.4 3 A 1.4 1.4 0 1 1 11.6 3 Z</Geometry>
  <!-- Route check -->
  <Geometry x:Key="SC_GlyphRouteCheck">M 2 12.5 l 3 -4.5 3.5 2 3 -5.5 M 0.9 12.5 A 1.1 1.1 0 1 1 3.1 12.5 A 1.1 1.1 0 1 1 0.9 12.5 Z M 10.4 4.5 A 1.1 1.1 0 1 1 12.6 4.5 A 1.1 1.1 0 1 1 10.4 4.5 Z M 9.5 13.2 l 1.6 1.4 3.4 -3.6</Geometry>
  <!-- Draw route -->
  <Geometry x:Key="SC_GlyphDraw">M 10.5 2.5 l 3 3 L 6 13 H 3 v -3 z M 9 4 l 3 3</Geometry>
  <!-- Check selected line -->
  <Geometry x:Key="SC_GlyphSelectLine">M 2.5 12.5 l 4 -6 3 3 4 -6 M 1.3 11.3 H 3.7 V 13.7 H 1.3 Z M 12.3 2.3 H 14.7 V 4.7 H 12.3 Z</Geometry>
  <!-- Water level, clearance -->
  <Geometry x:Key="SC_GlyphWater">M 1.5 6 c 1.6 -1.2 3 -1.2 4.4 0 s 2.8 1.2 4.2 0 2.8 -1.2 4.4 0 M 1.5 10 c 1.6 -1.2 3 -1.2 4.4 0 s 2.8 1.2 4.2 0 2.8 -1.2 4.4 0</Geometry>
  <!-- Export -->
  <Geometry x:Key="SC_GlyphExport">M 9.5 1.5 h -7 v 13 h 11 v -5 M 8 8 l 6.5 -6.5 M 10 1.5 h 4.5 V 6</Geometry>
  <!-- Log -->
  <Geometry x:Key="SC_GlyphLog">M 3 1.5 h 7 l 3 3 v 10 H 3 z M 5.5 7 h 5 M 5.5 9.5 h 5 M 5.5 12 h 3</Geometry>
  <!-- Chart server -->
  <Geometry x:Key="SC_GlyphServer">M 2 2 H 14 V 7 H 2 Z M 2 9 H 14 V 14 H 2 Z M 3.8 4.5 A 0.7 0.7 0 1 1 5.2 4.5 A 0.7 0.7 0 1 1 3.8 4.5 Z M 3.8 11.5 A 0.7 0.7 0 1 1 5.2 11.5 A 0.7 0.7 0 1 1 3.8 11.5 Z</Geometry>
  <!-- Open externally -->
  <Geometry x:Key="SC_GlyphLaunch">M 3 3 h 10 v 10 M 13 13 L 5 5 M 8.5 13 H 13 V 8.5</Geometry>
  <!-- Settings -->
  <Geometry x:Key="SC_GlyphSettings">M 5.8 8 A 2.2 2.2 0 1 1 10.2 8 A 2.2 2.2 0 1 1 5.8 8 Z M 8 1.5 v 2 M 8 12.5 v 2 M 1.5 8 h 2 M 12.5 8 h 2 M 3.4 3.4 l 1.4 1.4 M 11.2 11.2 l 1.4 1.4 M 3.4 12.6 l 1.4 -1.4 M 11.2 4.8 l 1.4 -1.4</Geometry>
  <!-- Severity: MUST REVIEW (octagon with !) -->
  <Geometry x:Key="SC_GlyphMustReview">M 5.2 1.5 h 5.6 l 3.7 3.7 v 5.6 l -3.7 3.7 H 5.2 l -3.7 -3.7 V 5.2 z M 8 4.6 v 4.4 M 7.2 11.2 A 0.8 0.8 0 1 1 8.8 11.2 A 0.8 0.8 0 1 1 7.2 11.2 Z</Geometry>
  <!-- Severity: CHECK and warnings (triangle with !) -->
  <Geometry x:Key="SC_GlyphCheck">M 8 1.8 L 15 14 H 1 z M 8 6 v 4 M 7.25 11.9 A 0.75 0.75 0 1 1 8.75 11.9 A 0.75 0.75 0 1 1 7.25 11.9 Z</Geometry>
  <!-- Severity: INFO and information (circle with i) -->
  <Geometry x:Key="SC_GlyphInfo">M 1.5 8 A 6.5 6.5 0 1 1 14.5 8 A 6.5 6.5 0 1 1 1.5 8 Z M 8 7.2 v 4 M 7.2 5 A 0.8 0.8 0 1 1 8.8 5 A 0.8 0.8 0 1 1 7.2 5 Z</Geometry>
  <!-- Severity: errors and failures (circle with x) -->
  <Geometry x:Key="SC_GlyphError">M 1.5 8 A 6.5 6.5 0 1 1 14.5 8 A 6.5 6.5 0 1 1 1.5 8 Z M 5.6 5.6 l 4.8 4.8 M 10.4 5.6 l -4.8 4.8</Geometry>
  <!-- Meets, valid (circle with a tick) -->
  <Geometry x:Key="SC_GlyphSuccess">M 1.5 8 A 6.5 6.5 0 1 1 14.5 8 A 6.5 6.5 0 1 1 1.5 8 Z M 5 8.2 l 2 2 4 -4.2</Geometry>

  <!-- ===================================================================
       Converters
       =================================================================== -->

  <!-- A view model's tone (SoundChartsTone, RouteCheckTone or a name) to sc:Tone.Value. -->
  <sc:ToneConverter x:Key="SC_ToneConverter" />

  <!-- ===================================================================
       Glyph styles
       =================================================================== -->

  <!-- A 16 px glyph in the surrounding text colour: set Data to an SC_Glyph…
       geometry, and Foreground (TextElement.Foreground) on it or a parent. -->
  <Style x:Key="SC_Glyph" TargetType="Path">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="StrokeThickness" Value="1.15" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
  </Style>

  <!-- A 12 px glyph: inline, in chips, section headers and footers. -->
  <Style x:Key="SC_GlyphSmall" TargetType="Path" BasedOn="{StaticResource SC_Glyph}">
    <Setter Property="StrokeThickness" Value="1.4" />
    <Setter Property="LayoutTransform">
      <Setter.Value>
        <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A severity glyph from sc:Tone.Value: Danger = octagon (MUST REVIEW),
       Warning = triangle (CHECK), Info = circle i (INFO), Success = circle
       tick, Neutral = circle i in the subdued colour. Set Data to use another
       shape in the tone's colour (SC_GlyphError for an error). -->
  <Style x:Key="SC_ToneGlyph" TargetType="Path" BasedOn="{StaticResource SC_Glyph}">
    <Setter Property="Data" Value="{StaticResource SC_GlyphInfo}" />
    <Setter Property="Stroke" Value="{DynamicResource SC_NeutralBrush}" />
    <Style.Triggers>
      <Trigger Property="sc:Tone.Value" Value="Info">
        <Setter Property="Stroke" Value="{DynamicResource SC_InfoBrush}" />
      </Trigger>
      <Trigger Property="sc:Tone.Value" Value="Success">
        <Setter Property="Data" Value="{StaticResource SC_GlyphSuccess}" />
        <Setter Property="Stroke" Value="{DynamicResource SC_SuccessBrush}" />
      </Trigger>
      <Trigger Property="sc:Tone.Value" Value="Warning">
        <Setter Property="Data" Value="{StaticResource SC_GlyphCheck}" />
        <Setter Property="Stroke" Value="{DynamicResource SC_WarningBrush}" />
      </Trigger>
      <Trigger Property="sc:Tone.Value" Value="Danger">
        <Setter Property="Data" Value="{StaticResource SC_GlyphMustReview}" />
        <Setter Property="Stroke" Value="{DynamicResource SC_DangerBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===================================================================
       Type ramp (§4.2). Foreground, size and weight only; Pro's font.
       =================================================================== -->

  <Style x:Key="SC_Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleDefaultBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SC_PageTitle" TargetType="TextBlock" BasedOn="{StaticResource SC_Body}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="SC_Title" TargetType="TextBlock" BasedOn="{StaticResource SC_Body}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="SC_VerdictTitle" TargetType="TextBlock" BasedOn="{StaticResource SC_Body}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="SC_RowTitle" TargetType="TextBlock" BasedOn="{StaticResource SC_Body}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="SC_Caption" TargetType="TextBlock" BasedOn="{StaticResource SC_Body}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleSubduedBrush}" />
  </Style>

  <!-- Section and group headers and the pick count. The caps come from the
       string; WPF has no letter spacing. -->
  <Style x:Key="SC_Overline" TargetType="TextBlock" BasedOn="{StaticResource SC_Body}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleSubduedBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="SC_Mono" TargetType="TextBlock" BasedOn="{StaticResource SC_Body}">
    <Setter Property="FontFamily" Value="{StaticResource SC_MonoFontFamily}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>

  <Style x:Key="SC_MonoSubdued" TargetType="TextBlock" BasedOn="{StaticResource SC_Mono}">
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleSubduedBrush}" />
  </Style>

  <!-- The one OptionalText: SC_Body that collapses when it has nothing to say. -->
  <Style x:Key="SC_OptionalText" TargetType="TextBlock" BasedOn="{StaticResource SC_Body}">
    <Style.Triggers>
      <Trigger Property="Text" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Text" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SC_OptionalCaption" TargetType="TextBlock" BasedOn="{StaticResource SC_Caption}">
    <Style.Triggers>
      <Trigger Property="Text" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Text" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SC_OptionalMono" TargetType="TextBlock" BasedOn="{StaticResource SC_MonoSubdued}">
    <Style.Triggers>
      <Trigger Property="Text" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Text" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A title in the mono face, as ids are: the Library's selected dataset. -->
  <Style x:Key="SC_MonoTitle" TargetType="TextBlock" BasedOn="{StaticResource SC_Title}">
    <Setter Property="FontFamily" Value="{StaticResource SC_MonoFontFamily}" />
  </Style>

  <!-- List cells: mono, one line, ellipsis, centred in the row (the Log). -->
  <Style x:Key="SC_MonoCell" TargetType="TextBlock" BasedOn="{StaticResource SC_Mono}">
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SC_MonoCellSubdued" TargetType="TextBlock" BasedOn="{StaticResource SC_MonoSubdued}">
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A column header over list cells: caption, one line, ellipsis. -->
  <Style x:Key="SC_ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource SC_Caption}">
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A status label's text (§5.7): one line with ellipsis, the full text in
       the label's tooltip. Give the label MaxWidth SC_StatusLabelMaxWidth. -->
  <Style x:Key="SC_StatusLabel" TargetType="TextBlock" BasedOn="{StaticResource SC_Body}">
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A link in running text, in the info ink: the Log link in a failure bar. -->
  <Style x:Key="SC_Hyperlink" TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{DynamicResource SC_InfoBrush}" />
  </Style>

  <!-- ===================================================================
       Buttons. Labelled buttons outside toolbars stay Pro's Esri_Button.
       =================================================================== -->

  <!-- Borderless toolbar button: optional sc:Ui.Glyph, then the content.
       With sc:Ui.OpensContextMenu it shows a ▾ and opens its ContextMenu. -->
  <Style x:Key="SC_ToolbarButton" TargetType="ButtonBase">
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleDefaultBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="2"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
              <Path x:Name="Glyph"
                    Style="{StaticResource SC_Glyph}"
                    Data="{Binding Path=(sc:Ui.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                    Margin="0,0,4,0" />
              <ContentPresenter x:Name="Label" VerticalAlignment="Center" RecognizesAccessKey="True" />
              <Path x:Name="MenuArrow"
                    Style="{StaticResource SC_GlyphSmall}"
                    Data="{StaticResource SC_GlyphChevronDown}"
                    Margin="2,0,0,0"
                    Visibility="Collapsed" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="sc:Ui.Glyph" Value="{x:Null}">
              <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Glyph" Property="Margin" Value="0" />
              <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="sc:Ui.OpensContextMenu" Value="True">
              <Setter TargetName="MenuArrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Esri_BackgroundHoverSelectedBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Esri_BackgroundPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A toolbar button with a ▾ that opens its ContextMenu: "Add ▾". -->
  <Style x:Key="SC_ToolbarMenuButton" TargetType="ButtonBase" BasedOn="{StaticResource SC_ToolbarButton}">
    <Setter Property="sc:Ui.OpensContextMenu" Value="True" />
  </Style>

  <!-- 24 x 24 icon-only button showing sc:Ui.Glyph. Needs a ToolTip and
       AutomationProperties.Name from Strings.resx. -->
  <Style x:Key="SC_IconButton" TargetType="ButtonBase">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleDefaultBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="2"
                  SnapsToDevicePixels="True">
            <Path Style="{StaticResource SC_Glyph}"
                  Data="{Binding Path=(sc:Ui.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                  HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Esri_BackgroundHoverSelectedBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Esri_BackgroundPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 20 x 20 icon-only button with a 12 px glyph, for actions inside rows. -->
  <Style x:Key="SC_SmallIconButton" TargetType="ButtonBase" BasedOn="{StaticResource SC_IconButton}">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="2"
                  SnapsToDevicePixels="True">
            <Path Style="{StaticResource SC_GlyphSmall}"
                  Data="{Binding Path=(sc:Ui.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                  HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Esri_BackgroundHoverSelectedBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Esri_BackgroundPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The ≡ menu at a toolbar's right end: opens its ContextMenu on click.
       Needs a ToolTip and AutomationProperties.Name from Strings.resx. -->
  <Style x:Key="SC_BurgerButton" TargetType="ButtonBase" BasedOn="{StaticResource SC_IconButton}">
    <Setter Property="sc:Ui.Glyph" Value="{StaticResource SC_GlyphBurger}" />
    <Setter Property="sc:Ui.OpensContextMenu" Value="True" />
  </Style>

  <!-- A row action (Object information on a finding row): hidden until its
       ListBoxItem (or ListViewItem) is hovered, selected or has keyboard
       focus. -->
  <Style x:Key="SC_RowAction" TargetType="ButtonBase" BasedOn="{StaticResource SC_SmallIconButton}">
    <Setter Property="Visibility" Value="Hidden" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- The dismiss button inside a chip (the Log's source filter): 16 px with
       a 12 px glyph, in the chip's ink. Set sc:Ui.Glyph to SC_GlyphClose. -->
  <Style x:Key="SC_ChipCloseButton" TargetType="ButtonBase" BasedOn="{StaticResource SC_SmallIconButton}">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
  </Style>

  <!-- A 22 px clickable row in a verdict card: the view lays out the label
       (SC_SummaryLabelColumn), the text and a chip as the content. -->
  <Style x:Key="SC_SummaryRow" TargetType="Button">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleDefaultBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Esri_BackgroundHoverSelectedBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Esri_BackgroundPressedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- SC_SummaryRow for a row that does nothing when clicked: the same 22 px
       layout, with no hover tint and no focus stop. -->
  <Style x:Key="SC_SummaryRowStatic" TargetType="ContentControl">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleDefaultBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================
       Pane and dialog structure
       =================================================================== -->

  <!-- 32 px pane toolbar with a 1 px bottom rule. Child: a DockPanel with
       LastChildFill="False": the labelled primary action docked left, icon
       buttons and SC_BurgerButton docked right. -->
  <Style x:Key="SC_PaneToolbar" TargetType="Border">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource SC_RuleBrush}" />
  </Style>

  <!-- A pane's header strip under the toolbar (Object information's pick
       header): padding 8 and a 1 px bottom rule. -->
  <Style x:Key="SC_PickHeader" TargetType="Border">
    <Setter Property="Padding" Value="8" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource SC_RuleBrush}" />
  </Style>

  <!-- Pane footer: 1 px top rule, a 12 px glyph (info unless sc:Ui.Glyph is
       set) and 11 px subdued text: "Not for navigation". -->
  <Style x:Key="SC_PaneFooter" TargetType="ContentControl">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleSubduedBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="sc:Ui.Glyph" Value="{StaticResource SC_GlyphInfo}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SC_RuleBrush}" Padding="8,6" Background="{TemplateBinding Background}">
            <DockPanel>
              <Path DockPanel.Dock="Left"
                    Style="{StaticResource SC_GlyphSmall}"
                    Data="{Binding Path=(sc:Ui.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                    VerticalAlignment="Top"
                    Margin="0,1,6,0" />
              <ContentPresenter VerticalAlignment="Center">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- SC_PaneFooter that collapses while its Content is null or empty. -->
  <Style x:Key="SC_OptionalPaneFooter" TargetType="ContentControl" BasedOn="{StaticResource SC_PaneFooter}">
    <Style.Triggers>
      <Trigger Property="Content" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Content" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Dialog footer: 1 px top rule, padding 16,12. Child: a DockPanel with
       Copy-type actions docked left and a right-aligned StackPanel of
       Esri_Button buttons (default first, MinWidth SC_DialogButtonMinWidth,
       Margin SC_ButtonGap between them). -->
  <Style x:Key="SC_DialogFooter" TargetType="Border">
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource SC_RuleBrush}" />
  </Style>

  <!-- Row splitter: a 7 px hit area with a 1 px line and a centre grip. Put
       it in its own Auto row between the two resizable rows. -->
  <Style x:Key="SC_Splitter" TargetType="GridSplitter">
    <Setter Property="Height" Value="7" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ResizeDirection" Value="Rows" />
    <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridSplitter">
          <Grid Background="{TemplateBinding Background}">
            <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource SC_RuleBrush}" />
            <Border Width="22"
                    Height="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderThickness="0,1"
                    BorderBrush="{DynamicResource SC_TagBorderBrush}"
                    Background="{TemplateBinding Background}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================
       Section headers
       =================================================================== -->

  <!-- Section header: optional 12 px glyph (in the sc:Tone.Value colour),
       the overline text (the content) and an optional sc:Ui.Count. -->
  <Style x:Key="SC_SectionHeader" TargetType="ContentControl">
    <Setter Property="Margin" Value="0,12,0,4" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleSubduedBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <StackPanel Orientation="Horizontal" Background="{TemplateBinding Background}">
            <Path x:Name="Glyph"
                  Style="{StaticResource SC_GlyphSmall}"
                  Data="{Binding Path=(sc:Ui.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                  Margin="0,0,6,0" />
            <ContentPresenter VerticalAlignment="Center" />
            <TextBlock x:Name="Count"
                       Text="{Binding Path=(sc:Ui.Count), RelativeSource={RelativeSource TemplatedParent}}"
                       FontWeight="Normal"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="sc:Ui.Glyph" Value="{x:Null}">
              <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="sc:Ui.Count" Value="{x:Null}">
              <Setter TargetName="Count" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="sc:Tone.Value" Value="Info">
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SC_InfoBrush}" />
            </Trigger>
            <Trigger Property="sc:Tone.Value" Value="Success">
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SC_SuccessBrush}" />
            </Trigger>
            <Trigger Property="sc:Tone.Value" Value="Warning">
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SC_WarningBrush}" />
            </Trigger>
            <Trigger Property="sc:Tone.Value" Value="Danger">
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SC_DangerBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Foldable section header: SC_SectionHeader with a 12 px chevron, on an
       Expander (Header = the overline text, content = the section). The
       header is a toggle button, so it folds from the keyboard too. -->
  <Style x:Key="SC_FoldableSectionHeader" TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleDefaultBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Top"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                          Padding="0,12,0,4"
                          FontSize="11"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource Esri_TextStyleSubduedBrush}"
                          HorizontalContentAlignment="Left">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="2">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Esri_BackgroundHoverSelectedBrush}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <StackPanel Orientation="Horizontal">
                <Path x:Name="Chevron"
                      Style="{StaticResource SC_GlyphSmall}"
                      Data="{StaticResource SC_GlyphChevronRight}"
                      Margin="0,0,4,0" />
                <Path x:Name="Glyph"
                      Style="{StaticResource SC_GlyphSmall}"
                      Data="{Binding Path=(sc:Ui.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                      Margin="0,0,6,0" />
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                <TextBlock x:Name="Count"
                           Text="{Binding Path=(sc:Ui.Count), RelativeSource={RelativeSource TemplatedParent}}"
                           FontWeight="Normal"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <ContentPresenter x:Name="Body" Visibility="Collapsed" />
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Body" Property="Visibility" Value="Visible" />
              <Setter TargetName="Chevron" Property="Data" Value="{StaticResource SC_GlyphChevronDown}" />
            </Trigger>
            <Trigger Property="sc:Ui.Glyph" Value="{x:Null}">
              <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="sc:Ui.Count" Value="{x:Null}">
              <Setter TargetName="Count" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="sc:Tone.Value" Value="Info">
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SC_InfoBrush}" />
            </Trigger>
            <Trigger Property="sc:Tone.Value" Value="Success">
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SC_SuccessBrush}" />
            </Trigger>
            <Trigger Property="sc:Tone.Value" Value="Warning">
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SC_WarningBrush}" />
            </Trigger>
            <Trigger Property="sc:Tone.Value" Value="Danger">
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SC_DangerBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================
       Lists and key/value fields
       =================================================================== -->

  <!-- List row layout, for a ListBox or ListView item template: a 16 px
       glyph (sc:Ui.Glyph, in the sc:Tone.Value colour), the Header as the
       row title, the Content as a caption line, and sc:Ui.Trailing (a chip or
       an SC_RowAction) at the right. Leaves selection to Pro's item style. -->
  <Style x:Key="SC_ListRow" TargetType="HeaderedContentControl">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleDefaultBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <Grid Margin="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Path x:Name="Glyph"
                  Grid.RowSpan="2"
                  Style="{StaticResource SC_Glyph}"
                  Data="{Binding Path=(sc:Ui.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                  VerticalAlignment="Top"
                  Margin="0,0,8,0" />
            <ContentPresenter Grid.Column="1" ContentSource="Header" TextElement.FontWeight="SemiBold">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
            <ContentPresenter x:Name="Caption"
                              Grid.Row="1"
                              Grid.Column="1"
                              TextElement.FontSize="11"
                              TextElement.Foreground="{DynamicResource Esri_TextStyleSubduedBrush}">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
            <ContentPresenter x:Name="Trailing"
                              Grid.Column="2"
                              Grid.RowSpan="2"
                              Content="{Binding Path=(sc:Ui.Trailing), RelativeSource={RelativeSource TemplatedParent}}"
                              VerticalAlignment="Top"
                              Margin="8,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="sc:Ui.Glyph" Value="{x:Null}">
              <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Caption" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="sc:Ui.Trailing" Value="{x:Null}">
              <Setter TargetName="Trailing" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="sc:Tone.Value" Value="Info">
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SC_InfoBrush}" />
            </Trigger>
            <Trigger Property="sc:Tone.Value" Value="Success">
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SC_SuccessBrush}" />
            </Trigger>
            <Trigger Property="sc:Tone.Value" Value="Warning">
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SC_WarningBrush}" />
            </Trigger>
            <Trigger Property="sc:Tone.Value" Value="Danger">
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SC_DangerBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A flat list row container for a ListBox's ItemContainerStyle: no
       padding or border of its own (the item template lays out the row),
       full-width hover and Pro's selection fill. Self-contained, so it
       doesn't depend on finding Pro's ListBoxItem style at load time. -->
  <Style x:Key="SC_ListItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleDefaultBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Esri_BackgroundHoverSelectedBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Esri_BackgroundSelectedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Key/value grid: an ItemsControl whose item template is a two-column
       Grid, the label column SharedSizeGroup="SC_FieldLabel". -->
  <Style x:Key="SC_FieldGrid" TargetType="ItemsControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Grid.IsSharedSizeScope" Value="True" />
  </Style>

  <!-- A field's label: subdued, 12 px gap to the value. -->
  <Style x:Key="SC_FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource SC_Body}">
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleSubduedBrush}" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>

  <!-- A field's value: a read-only TextBox with no chrome, so it can be
       selected and copied. Give it AutomationProperties.Name. -->
  <Style x:Key="SC_FieldValue" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleDefaultBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Esri_TextStyleDefaultBrush}" />
  </Style>

  <Style x:Key="SC_FieldValueMono" TargetType="TextBox" BasedOn="{StaticResource SC_FieldValue}">
    <Setter Property="FontFamily" Value="{StaticResource SC_MonoFontFamily}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>

  <!-- ===================================================================
       Forms (Options and dialogs)
       =================================================================== -->

  <!-- A form label in the label column (SC_FormLabelColumnDialog or
       SC_FormLabelColumnOptions). Set Target for an access key. -->
  <Style x:Key="SC_FormLabel" TargetType="TextBlock" BasedOn="{StaticResource SC_Body}">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>

  <!-- Help text under a field. -->
  <Style x:Key="SC_FormHelp" TargetType="TextBlock" BasedOn="{StaticResource SC_Caption}">
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <!-- ===================================================================
       Chips, tags and tones
       =================================================================== -->

  <!-- Status chip: 18 px, radius 2, sc:Tone.Value fill, edge and ink, an
       optional 12 px sc:Ui.Glyph. Always a word with the tone. -->
  <Style x:Key="SC_Chip" TargetType="ContentControl">
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource SC_NeutralBrush}" />
    <Setter Property="Background" Value="{DynamicResource SC_NeutralFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SC_NeutralEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  CornerRadius="2"
                  SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path x:Name="Glyph"
                    Style="{StaticResource SC_GlyphSmall}"
                    Data="{Binding Path=(sc:Ui.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                    Margin="0,0,4,0" />
              <ContentPresenter VerticalAlignment="Center">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="NoWrap" />
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="sc:Ui.Glyph" Value="{x:Null}">
              <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="sc:Tone.Value" Value="Info">
        <Setter Property="Foreground" Value="{DynamicResource SC_InfoBrush}" />
        <Setter Property="Background" Value="{DynamicResource SC_InfoFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SC_InfoEdgeBrush}" />
      </Trigger>
      <Trigger Property="sc:Tone.Value" Value="Success">
        <Setter Property="Foreground" Value="{DynamicResource SC_SuccessBrush}" />
        <Setter Property="Background" Value="{DynamicResource SC_SuccessFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SC_SuccessEdgeBrush}" />
      </Trigger>
      <Trigger Property="sc:Tone.Value" Value="Warning">
        <Setter Property="Foreground" Value="{DynamicResource SC_WarningBrush}" />
        <Setter Property="Background" Value="{DynamicResource SC_WarningFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SC_WarningEdgeBrush}" />
      </Trigger>
      <Trigger Property="sc:Tone.Value" Value="Danger">
        <Setter Property="Foreground" Value="{DynamicResource SC_DangerBrush}" />
        <Setter Property="Background" Value="{DynamicResource SC_DangerFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SC_DangerEdgeBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A chip for numbers and identifiers: mono 10.5 px. -->
  <Style x:Key="SC_MonoChip" TargetType="ContentControl" BasedOn="{StaticResource SC_Chip}">
    <Setter Property="FontFamily" Value="{StaticResource SC_MonoFontFamily}" />
    <Setter Property="FontSize" Value="10.5" />
  </Style>

  <!-- Product tag: a bordered mono tag (S-101, S-104, ExS, Dir), min width 40.
       Neutral: no per-product hue (§10 decision 12). -->
  <Style x:Key="SC_ProductTag" TargetType="ContentControl">
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="FontFamily" Value="{StaticResource SC_MonoFontFamily}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleSubduedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SC_TagBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  CornerRadius="2"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- SC_ProductTag that collapses while its Content is null: collections
       have no product. -->
  <Style x:Key="SC_OptionalProductTag" TargetType="ContentControl" BasedOn="{StaticResource SC_ProductTag}">
    <Style.Triggers>
      <Trigger Property="Content" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A chip that is also a button (the Log's count chips): SC_Chip's look
       from sc:Tone.Value and sc:Ui.Glyph, a hand cursor and a keyboard stop.
       Give it a ToolTip and AutomationProperties.HelpText saying what a
       click does. -->
  <Style x:Key="SC_ChipButton" TargetType="ButtonBase">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <ContentControl x:Name="Chip"
                          Style="{StaticResource SC_Chip}"
                          sc:Tone.Value="{Binding Path=(sc:Tone.Value), RelativeSource={RelativeSource TemplatedParent}}"
                          sc:Ui.Glyph="{Binding Path=(sc:Ui.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                          Content="{TemplateBinding Content}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chip" Property="BorderThickness" Value="1.5" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chip" Property="Opacity" Value="0.8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Verdict card: sc:Tone.Value tint (6%), edge (40%), radius 3, padding
       10,9. Set the same tone on the SC_ToneGlyph inside. -->
  <Style x:Key="SC_VerdictCard" TargetType="Border">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource SC_NeutralTintBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SC_NeutralEdgeBrush}" />
    <Style.Triggers>
      <Trigger Property="sc:Tone.Value" Value="Info">
        <Setter Property="Background" Value="{DynamicResource SC_InfoTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SC_InfoEdgeBrush}" />
      </Trigger>
      <Trigger Property="sc:Tone.Value" Value="Success">
        <Setter Property="Background" Value="{DynamicResource SC_SuccessTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SC_SuccessEdgeBrush}" />
      </Trigger>
      <Trigger Property="sc:Tone.Value" Value="Warning">
        <Setter Property="Background" Value="{DynamicResource SC_WarningTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SC_WarningEdgeBrush}" />
      </Trigger>
      <Trigger Property="sc:Tone.Value" Value="Danger">
        <Setter Property="Background" Value="{DynamicResource SC_DangerTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SC_DangerEdgeBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- The verdict card's shape while work runs (Route check's Working
       state): neutral tint and edge, a 16 px spinner, then the content as a
       verdict title. Live region (polite); the card keeps its place, so
       nothing jumps when the verdict lands. -->
  <Style x:Key="SC_WorkingCard" TargetType="ContentControl">
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border CornerRadius="3"
                  BorderThickness="1"
                  Padding="{TemplateBinding Padding}"
                  Background="{DynamicResource SC_NeutralTintBrush}"
                  BorderBrush="{DynamicResource SC_NeutralEdgeBrush}"
                  SnapsToDevicePixels="True">
            <DockPanel>
              <controls:CircularAnimationControl DockPanel.Dock="Left"
                                                 Width="16"
                                                 Height="16"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
              <ContentPresenter VerticalAlignment="Center"
                                TextElement.FontSize="13"
                                TextElement.FontWeight="SemiBold"
                                TextElement.Foreground="{DynamicResource Esri_TextStyleDefaultBrush}" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================
       Messages and states
       =================================================================== -->

  <!-- Message bar: a 3 px tone bar, the tone's glyph, an optional bold
       Header and the Content, wrapped. sc:Tone.Value Info (default),
       Warning, Danger (error glyph), Success or Neutral. -->
  <Style x:Key="SC_MessageBar" TargetType="HeaderedContentControl">
    <Setter Property="sc:Tone.Value" Value="Info" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleDefaultBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <Border x:Name="Edge"
                  BorderThickness="0,1,1,1"
                  BorderBrush="{DynamicResource SC_InfoEdgeBrush}"
                  Background="{DynamicResource SC_InfoTintBrush}"
                  SnapsToDevicePixels="True">
            <DockPanel>
              <Rectangle x:Name="Bar" DockPanel.Dock="Left" Width="3" Fill="{DynamicResource SC_InfoBrush}" />
              <Path x:Name="Glyph"
                    DockPanel.Dock="Left"
                    Style="{StaticResource SC_Glyph}"
                    Data="{StaticResource SC_GlyphInfo}"
                    Stroke="{DynamicResource SC_InfoBrush}"
                    VerticalAlignment="Top"
                    Margin="8,6,0,6" />
              <StackPanel Margin="8,6,8,6" VerticalAlignment="Center">
                <ContentPresenter x:Name="Header" ContentSource="Header" TextElement.FontWeight="SemiBold">
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
                <ContentPresenter>
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
              </StackPanel>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Header" Value="{x:Null}">
              <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="sc:Tone.Value" Value="Neutral">
              <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource SC_NeutralEdgeBrush}" />
              <Setter TargetName="Edge" Property="Background" Value="{DynamicResource SC_NeutralTintBrush}" />
              <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource SC_NeutralBrush}" />
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SC_NeutralBrush}" />
            </Trigger>
            <Trigger Property="sc:Tone.Value" Value="Success">
              <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource SC_SuccessEdgeBrush}" />
              <Setter TargetName="Edge" Property="Background" Value="{DynamicResource SC_SuccessTintBrush}" />
              <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource SC_SuccessBrush}" />
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SC_SuccessBrush}" />
              <Setter TargetName="Glyph" Property="Data" Value="{StaticResource SC_GlyphSuccess}" />
            </Trigger>
            <Trigger Property="sc:Tone.Value" Value="Warning">
              <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource SC_WarningEdgeBrush}" />
              <Setter TargetName="Edge" Property="Background" Value="{DynamicResource SC_WarningTintBrush}" />
              <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource SC_WarningBrush}" />
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SC_WarningBrush}" />
              <Setter TargetName="Glyph" Property="Data" Value="{StaticResource SC_GlyphCheck}" />
            </Trigger>
            <Trigger Property="sc:Tone.Value" Value="Danger">
              <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource SC_DangerEdgeBrush}" />
              <Setter TargetName="Edge" Property="Background" Value="{DynamicResource SC_DangerTintBrush}" />
              <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource SC_DangerBrush}" />
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource SC_DangerBrush}" />
              <Setter TargetName="Glyph" Property="Data" Value="{StaticResource SC_GlyphError}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- SC_MessageBar that collapses while its Content is null or empty: a
       last action's message, a field's problem. -->
  <Style x:Key="SC_OptionalMessageBar" TargetType="HeaderedContentControl" BasedOn="{StaticResource SC_MessageBar}">
    <Style.Triggers>
      <Trigger Property="Content" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Content" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- NOT FOR NAVIGATION strip: caution colours, a warning glyph and 11 px
       bold text (the content, from Strings.resx). Give it the existing
       tooltip. Only where the producer marks the data (§7.1). -->
  <Style x:Key="SC_CautionStrip" TargetType="ContentControl">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource SC_CautionInkBrush}" />
    <Setter Property="Background" Value="{DynamicResource SC_CautionBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SC_CautionBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  CornerRadius="2"
                  SnapsToDevicePixels="True">
            <DockPanel>
              <Path DockPanel.Dock="Left"
                    Style="{StaticResource SC_Glyph}"
                    Data="{StaticResource SC_GlyphCheck}"
                    Margin="0,0,8,0" />
              <ContentPresenter VerticalAlignment="Center">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Empty state: a 40 px tinted disc with sc:Ui.Glyph, the Header as a
       14 px title, the Content as subdued body text (max 300 px) and
       sc:Ui.Actions (buttons) under it, centred. -->
  <Style x:Key="SC_EmptyState" TargetType="HeaderedContentControl">
    <Setter Property="Padding" Value="24" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleDefaultBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <StackPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="Center">
            <Border x:Name="Disc"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource SC_InfoFillBrush}">
              <Path Style="{StaticResource SC_Glyph}"
                    Data="{Binding Path=(sc:Ui.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                    Stroke="{DynamicResource SC_InfoBrush}"
                    HorizontalAlignment="Center" />
            </Border>
            <ContentPresenter ContentSource="Header"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Center"
                              TextElement.FontSize="14"
                              TextElement.FontWeight="SemiBold">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                  <Setter Property="TextAlignment" Value="Center" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
            <ContentPresenter x:Name="Body"
                              Margin="0,8,0,0"
                              MaxWidth="300"
                              HorizontalAlignment="Center"
                              TextElement.Foreground="{DynamicResource Esri_TextStyleSubduedBrush}">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                  <Setter Property="TextAlignment" Value="Center" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
            <ContentPresenter x:Name="Actions"
                              Margin="0,12,0,0"
                              HorizontalAlignment="Center"
                              Content="{Binding Path=(sc:Ui.Actions), RelativeSource={RelativeSource TemplatedParent}}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="sc:Ui.Glyph" Value="{x:Null}">
              <Setter TargetName="Disc" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="sc:Ui.Actions" Value="{x:Null}">
              <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Drop zone: the content (a caption) inside a dashed 1 px edge, which
       takes the accent (info) colour while sc:Ui.IsDragOver is true. The
       view sets sc:Ui.IsDragOver from its drag events. -->
  <Style x:Key="SC_DropZone" TargetType="ContentControl">
    <Setter Property="Padding" Value="12" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleSubduedBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Rectangle x:Name="Edge"
                       Stroke="{DynamicResource SC_TagBorderBrush}"
                       StrokeThickness="1"
                       StrokeDashArray="4 3"
                       RadiusX="2"
                       RadiusY="2"
                       SnapsToDevicePixels="True" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                  <Setter Property="TextAlignment" Value="Center" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="sc:Ui.IsDragOver" Value="True">
              <Setter TargetName="Edge" Property="Stroke" Value="{DynamicResource SC_InfoBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Busy state: Pro's CircularAnimationControl (24 px) above the content,
       a subdued caption such as "Finding features...". -->
  <Style x:Key="SC_BusyState" TargetType="ContentControl">
    <Setter Property="Padding" Value="24" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleSubduedBrush}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <StackPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="Center">
            <controls:CircularAnimationControl Width="24" Height="24" HorizontalAlignment="Center" />
            <ContentPresenter Margin="0,8,0,0" HorizontalAlignment="Center">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                  <Setter Property="TextAlignment" Value="Center" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
