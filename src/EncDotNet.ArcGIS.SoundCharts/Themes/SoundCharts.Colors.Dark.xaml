<!-- SoundCharts tone brushes for Pro's Dark theme. SoundChartsTheme merges
     this file when Pro's ApplicationTheme is Dark. Every key here is also in
     the Light and HighContrast files; keep the three in step.

     Ink brushes meet 4.5:1 on their own 11% fill over Pro's dark pane
     (#2E2E2E, and #353535). Fills and edges are the ink with alpha: 11% (1C)
     for chips, 6% (0F) for cards, bars and rows, 40% (66) for edges. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Tone inks: text, glyphs and bars. -->
  <SolidColorBrush x:Key="SC_DangerBrush" Color="#FF9485" />
  <SolidColorBrush x:Key="SC_WarningBrush" Color="#FFB938" />
  <SolidColorBrush x:Key="SC_SuccessBrush" Color="#58C771" />
  <SolidColorBrush x:Key="SC_InfoBrush" Color="#5BBAF5" />
  <SolidColorBrush x:Key="SC_NeutralBrush" Color="#B1B1B1" />

  <!-- Chip fills: the ink at 11%. -->
  <SolidColorBrush x:Key="SC_DangerFillBrush" Color="#1CFF9485" />
  <SolidColorBrush x:Key="SC_WarningFillBrush" Color="#1CFFB938" />
  <SolidColorBrush x:Key="SC_SuccessFillBrush" Color="#1C58C771" />
  <SolidColorBrush x:Key="SC_InfoFillBrush" Color="#1C5BBAF5" />
  <SolidColorBrush x:Key="SC_NeutralFillBrush" Color="#1CB1B1B1" />

  <!-- Card, message bar and row tints: the ink at 6%. -->
  <SolidColorBrush x:Key="SC_DangerTintBrush" Color="#0FFF9485" />
  <SolidColorBrush x:Key="SC_WarningTintBrush" Color="#0FFFB938" />
  <SolidColorBrush x:Key="SC_SuccessTintBrush" Color="#0F58C771" />
  <SolidColorBrush x:Key="SC_InfoTintBrush" Color="#0F5BBAF5" />
  <SolidColorBrush x:Key="SC_NeutralTintBrush" Color="#0FB1B1B1" />

  <!-- Edges: the ink at 40%. -->
  <SolidColorBrush x:Key="SC_DangerEdgeBrush" Color="#66FF9485" />
  <SolidColorBrush x:Key="SC_WarningEdgeBrush" Color="#66FFB938" />
  <SolidColorBrush x:Key="SC_SuccessEdgeBrush" Color="#6658C771" />
  <SolidColorBrush x:Key="SC_InfoEdgeBrush" Color="#665BBAF5" />
  <SolidColorBrush x:Key="SC_NeutralEdgeBrush" Color="#66B1B1B1" />

  <!-- NOT FOR NAVIGATION strip. -->
  <SolidColorBrush x:Key="SC_CautionBackgroundBrush" Color="#3A2F12" />
  <SolidColorBrush x:Key="SC_CautionBorderBrush" Color="#9A7A21" />
  <SolidColorBrush x:Key="SC_CautionInkBrush" Color="#FFD670" />

  <!-- Lines: toolbar and footer rules, splitters, faint row rules (the Log)
       and product tag borders. -->
  <SolidColorBrush x:Key="SC_RuleBrush" Color="#454545" />
  <SolidColorBrush x:Key="SC_RowRuleBrush" Color="#3A3A3A" />
  <SolidColorBrush x:Key="SC_TagBorderBrush" Color="#5A5A5A" />

  <!-- The app icon (About), 64 px drawn at 32 so it stays sharp at 200%.
       The dark rendering, as Pro shows the ribbon icon in this theme. -->
  <BitmapImage x:Key="SC_AppIcon" UriSource="pack://application:,,,/EncDotNet.ArcGIS.SoundCharts;component/DarkImages/AboutSoundCharts32.scale-200.png" />

</ResourceDictionary>
