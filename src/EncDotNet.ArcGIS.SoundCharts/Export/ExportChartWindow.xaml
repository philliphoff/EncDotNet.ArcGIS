<controls:ProWindow x:Class="EncDotNet.SoundCharts.Export.ExportChartWindow"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
                    xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
                    xmlns:res="clr-namespace:EncDotNet.SoundCharts.Resources"
                    Title="{x:Static res:Strings.Export_Title}"
                    SizeToContent="WidthAndHeight"
                    ResizeMode="NoResize"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner"
                    AutomationProperties.AutomationId="ExportChart">
  <controls:ProWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </controls:ProWindow.Resources>

  <StackPanel Margin="16" Width="460">
    <TextBlock Text="{Binding Heading}"
               Style="{DynamicResource Esri_TextBlockH3}"
               TextWrapping="Wrap"
               Margin="0,0,0,4" />
    <TextBlock Text="{Binding Summary}"
               Style="{DynamicResource Esri_TextBlockRegular}"
               TextWrapping="Wrap"
               Margin="0,0,0,12" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Label Content="{x:Static res:Strings.Export_FileLabel}"
             Target="{Binding ElementName=OutputPath}"
             Style="{DynamicResource Esri_Label}"
             VerticalAlignment="Center"
             Margin="0,0,8,6" />
      <TextBox x:Name="OutputPath"
               Grid.Column="1"
               Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
               Margin="0,0,6,6"
               AutomationProperties.AutomationId="ExportChart.File"
               AutomationProperties.Name="{x:Static res:Strings.Export_FileLabel}" />
      <Button Grid.Column="2"
              Content="{x:Static res:Strings.Button_Browse}"
              ToolTip="{x:Static res:Strings.Tooltip_ExportBrowse}"
              Style="{DynamicResource Esri_Button}"
              Click="OnBrowseClick"
              Margin="0,0,0,6"
              AutomationProperties.AutomationId="ExportChart.Browse"
              AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_ExportBrowse}" />

      <Label Grid.Row="1"
             Content="{x:Static res:Strings.Export_FormatLabel}"
             Target="{Binding ElementName=Format}"
             Style="{DynamicResource Esri_Label}"
             VerticalAlignment="Center"
             Margin="0,0,8,6" />
      <ComboBox x:Name="Format"
                Grid.Row="1"
                Grid.Column="1"
                ItemsSource="{Binding Formats}"
                SelectedItem="{Binding Format}"
                DisplayMemberPath="Label"
                ToolTip="{x:Static res:Strings.Tooltip_ExportFormat}"
                Margin="0,0,6,6"
                AutomationProperties.AutomationId="ExportChart.Format"
                AutomationProperties.Name="{x:Static res:Strings.Export_FormatLabel}" />

      <Label Grid.Row="2"
             Content="{x:Static res:Strings.Export_ResolutionLabel}"
             Target="{Binding ElementName=Resolution}"
             Style="{DynamicResource Esri_Label}"
             VerticalAlignment="Center"
             Margin="0,0,8,0" />
      <ComboBox x:Name="Resolution"
                Grid.Row="2"
                Grid.Column="1"
                ItemsSource="{Binding Resolutions}"
                SelectedItem="{Binding Resolution}"
                DisplayMemberPath="Label"
                ToolTip="{x:Static res:Strings.Tooltip_ExportResolution}"
                Margin="0,0,6,0"
                AutomationProperties.AutomationId="ExportChart.Resolution"
                AutomationProperties.Name="{x:Static res:Strings.Export_ResolutionLabel}" />
    </Grid>

    <TextBlock Text="{x:Static res:Strings.Export_Note}"
               Style="{DynamicResource Esri_TextBlockRegular}"
               TextWrapping="Wrap"
               Margin="0,12,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{x:Static res:Strings.Button_Export}"
              Style="{DynamicResource Esri_Button}"
              IsDefault="True"
              IsEnabled="{Binding CanExport}"
              Click="OnExportClick"
              AutomationProperties.AutomationId="ExportChart.Export" />
      <Button Content="{x:Static res:Strings.Button_Cancel}"
              Style="{DynamicResource Esri_Button}"
              IsCancel="True"
              AutomationProperties.AutomationId="ExportChart.Cancel" />
    </StackPanel>
  </StackPanel>
</controls:ProWindow>
