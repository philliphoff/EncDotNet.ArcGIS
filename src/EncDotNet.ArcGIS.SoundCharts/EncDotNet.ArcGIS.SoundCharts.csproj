<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- ArcGIS Pro is an x64 process, also on Arm64 Windows, where it runs
         under emulation. Building for win-x64 also keeps the package to the
         x64 natives: without a RID, every SkiaSharp native is copied and the
         package paths pass MAX_PATH. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Pro loads the add-in from the .esriAddinX, so NuGet dependencies are
         copied next to the add-in assembly to be packaged with it. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Not EncDotNet.ArcGIS.SoundCharts: inside a namespace with an "ArcGIS"
         segment, the Pro SDK's ArcGIS.* namespaces no longer resolve, and the
         WPF code generator doesn't qualify them with global::. -->
    <RootNamespace>EncDotNet.SoundCharts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packaged at the root of the .esriAddinX. -->
    <Content Include="Config.daml" />
  </ItemGroup>

  <!-- The ribbon and pane images Config.daml names (design proposal §4.5),
       rendered from Images/src by tools/render-icons.py. Content, packaged
       at Images/ and DarkImages/ in the .esriAddinX: Pro reads an image from
       DarkImages/ instead of Images/ in its Dark theme. Config.daml names
       the 100% files; the .scale-150 and .scale-200 renderings are kept
       beside them for high-DPI use. -->
  <ItemGroup>
    <Content Include="Images\*.png;DarkImages\*.png" />
  </ItemGroup>

  <!-- The About window's app icon, SC_AppIcon in the theme's colour
       dictionaries: also a WPF resource in the assembly, which a pack URI
       reaches; the .esriAddinX Content above isn't. -->
  <ItemGroup>
    <Resource Include="Images\AboutSoundCharts32.scale-200.png;DarkImages\AboutSoundCharts32.scale-200.png" />
  </ItemGroup>

  <!-- SoundCharts Tools, the Python toolbox (A9). Pro copies an add-in's
       Toolboxes folder to %LOCALAPPDATA%\ESRI\ArcGISPro\Toolboxes\{add-in id}
       and lists the toolboxes in it in the Geoprocessing pane. Esri's
       PackageArcGISContents target puts Content at the package root only
       when it isn't copied to the output folder; copied, it lands under
       Install\ with the assemblies. CI checks the package. -->
  <ItemGroup>
    <Content Include="Toolboxes\**\*"
             Exclude="Toolboxes\**\__pycache__\**;Toolboxes\**\*.pyc" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Esri.ArcGISPro.Extensions30" />
    <PackageReference Include="EncDotNet.S100" />
    <PackageReference Include="EncDotNet.S100.Collections" />
    <PackageReference Include="EncDotNet.S100.Routes.Rtz" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EncDotNet.ArcGIS.SoundCharts.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EncDotNet.ArcGIS.SoundCharts.Core\EncDotNet.ArcGIS.SoundCharts.Core.csproj" />
  </ItemGroup>

  <!-- The pinned s100 chart server (design brief D21), built by
       tools/build-server.ps1 into artifacts/server/<rid>/. Copied to
       server/<rid>/ in the output, and so packaged in the .esriAddinX beside
       the add-in assembly. Without it the add-in builds and loads, but chart
       servers fail to start, saying s100 isn't installed. -->
  <PropertyGroup>
    <SoundChartsServerDirectory Condition="'$(SoundChartsServerDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\server\</SoundChartsServerDirectory>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(SoundChartsServerDirectory)')">
    <None Include="$(SoundChartsServerDirectory)win-*\**\*"
          Link="server\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
