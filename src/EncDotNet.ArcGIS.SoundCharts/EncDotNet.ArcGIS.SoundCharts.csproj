<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- ArcGIS Pro is an x64 process, also on Arm64 Windows, where it runs
         under emulation. Building for win-x64 also keeps the package to the
         x64 natives: without a RID, every SkiaSharp native is copied and the
         package paths pass MAX_PATH. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Pro loads the add-in from the .esriAddinX, so NuGet dependencies are
         copied next to the add-in assembly to be packaged with it. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Not EncDotNet.ArcGIS.SoundCharts: inside a namespace with an "ArcGIS"
         segment, the Pro SDK's ArcGIS.* namespaces no longer resolve, and the
         WPF code generator doesn't qualify them with global::. -->
    <RootNamespace>EncDotNet.SoundCharts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packaged at the root of the .esriAddinX. -->
    <Content Include="Config.daml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Esri.ArcGISPro.Extensions30" />
    <PackageReference Include="EncDotNet.S100" />
    <PackageReference Include="EncDotNet.S100.Collections" />
    <PackageReference Include="EncDotNet.S100.Routes.Rtz" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EncDotNet.ArcGIS.SoundCharts.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EncDotNet.ArcGIS.SoundCharts.Core\EncDotNet.ArcGIS.SoundCharts.Core.csproj" />
  </ItemGroup>

  <!-- The pinned s100 chart server (design brief D21), built by
       tools/build-server.ps1 into artifacts/server/<rid>/. Copied to
       server/<rid>/ in the output, and so packaged in the .esriAddinX beside
       the add-in assembly. Without it the add-in builds and loads, but chart
       servers fail to start, saying s100 isn't installed. -->
  <PropertyGroup>
    <SoundChartsServerDirectory Condition="'$(SoundChartsServerDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\server\</SoundChartsServerDirectory>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(SoundChartsServerDirectory)')">
    <None Include="$(SoundChartsServerDirectory)win-*\**\*"
          Link="server\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
