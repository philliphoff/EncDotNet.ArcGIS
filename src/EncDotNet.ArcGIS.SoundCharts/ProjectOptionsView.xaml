<UserControl x:Class="EncDotNet.SoundCharts.ProjectOptionsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:res="clr-namespace:EncDotNet.SoundCharts.Resources"
             AutomationProperties.AutomationId="ProjectOptions">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="8">
      <TextBlock Text="{x:Static res:Strings.Settings_ProjectHeading}" Style="{DynamicResource Esri_TextBlockH3}" />
      <TextBlock Text="{x:Static res:Strings.Settings_ScopeNote}" Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,4,0,0" />
      <TextBlock Text="{x:Static res:Strings.Settings_ProjectNote}" Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,2,0,8" />

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="160" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Settings_Palette}" Style="{DynamicResource Esri_TextBlockRegular}" VerticalAlignment="Center" />
        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2" MinWidth="160" HorizontalAlignment="Left"
                  ItemsSource="{Binding Palettes}" SelectedItem="{Binding Palette}" DisplayMemberPath="Label"
                  AutomationProperties.AutomationId="ProjectOptions.Palette"
                  AutomationProperties.Name="{x:Static res:Strings.Settings_Palette}" />

        <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4" IsChecked="{Binding ShowText}"
                  Content="{x:Static res:Strings.Settings_Text}" ToolTip="{x:Static res:Strings.Tooltip_Text}"
                  AutomationProperties.AutomationId="ProjectOptions.Text"
                  AutomationProperties.Name="{x:Static res:Strings.Settings_Text}" />

        <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Settings_SymbolScale}" ToolTip="{x:Static res:Strings.Tooltip_SymbolScale}"
                   Style="{DynamicResource Esri_TextBlockRegular}" VerticalAlignment="Center" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
          <Slider Width="180" Minimum="0.5" Maximum="3.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                  Value="{Binding SymbolScale}" ToolTip="{x:Static res:Strings.Tooltip_SymbolScale}"
                  AutomationProperties.AutomationId="ProjectOptions.SymbolScale"
                  AutomationProperties.Name="{x:Static res:Strings.Settings_SymbolScale}" />
          <TextBlock Text="{Binding SymbolScaleText}" Style="{DynamicResource Esri_TextBlockRegular}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{x:Static res:Strings.Settings_TextScale}" ToolTip="{x:Static res:Strings.Tooltip_TextScale}"
                   Style="{DynamicResource Esri_TextBlockRegular}" VerticalAlignment="Center" />
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
          <Slider Width="180" Minimum="0.5" Maximum="3.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                  Value="{Binding TextScale}" ToolTip="{x:Static res:Strings.Tooltip_TextScale}"
                  AutomationProperties.AutomationId="ProjectOptions.TextScale"
                  AutomationProperties.Name="{x:Static res:Strings.Settings_TextScale}" />
          <TextBlock Text="{Binding TextScaleText}" Style="{DynamicResource Esri_TextBlockRegular}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{x:Static res:Strings.Settings_NationalLanguage}" ToolTip="{x:Static res:Strings.Tooltip_NationalLanguage}"
                   Style="{DynamicResource Esri_TextBlockRegular}" VerticalAlignment="Center" />
        <TextBox Grid.Row="4" Grid.Column="1" Width="60" HorizontalAlignment="Left" Margin="0,2" MaxLength="3"
                 Text="{Binding NationalLanguage, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{x:Static res:Strings.Tooltip_NationalLanguage}"
                 AutomationProperties.AutomationId="ProjectOptions.NationalLanguage"
                 AutomationProperties.Name="{x:Static res:Strings.Settings_NationalLanguage}" />
      </Grid>

      <!-- Settings the chart server doesn't take yet (U1): kept and shown, but disabled. -->
      <Border Margin="0,12,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Esri_BorderBrush}">
        <StackPanel>
          <TextBlock Text="{x:Static res:Strings.Settings_NeedsServer}" Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap"
                     FontStyle="Italic" Margin="0,0,0,8"
                     Visibility="{Binding ShowNeedsServer, Converter={StaticResource BooleanToVisibility}}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="160" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Settings_DisplayCategory}" Style="{DynamicResource Esri_TextBlockRegular}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2" MinWidth="160" HorizontalAlignment="Left"
                      IsEnabled="{Binding DisplayCategoryEnabled}"
                      ItemsSource="{Binding DisplayCategories}" SelectedItem="{Binding DisplayCategory}" DisplayMemberPath="Label"
                      AutomationProperties.AutomationId="ProjectOptions.DisplayCategory"
                      AutomationProperties.Name="{x:Static res:Strings.Settings_DisplayCategory}" />

            <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4" IsChecked="{Binding ShowSoundings}" IsEnabled="{Binding SoundingsEnabled}"
                      Content="{x:Static res:Strings.Settings_Soundings}"
                      AutomationProperties.AutomationId="ProjectOptions.Soundings"
                      AutomationProperties.Name="{x:Static res:Strings.Settings_Soundings}" />

            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Static res:Strings.Settings_DepthsSection}" Style="{DynamicResource Esri_TextBlockH5}" Margin="0,8,0,2" />

            <TextBlock Grid.Row="3" Text="{x:Static res:Strings.Settings_SafetyContour}" ToolTip="{x:Static res:Strings.Tooltip_SafetyContour}"
                       Style="{DynamicResource Esri_TextBlockRegular}" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,2" IsEnabled="{Binding PortrayalEnabled}"
                     Text="{Binding SafetyContour}" ToolTip="{x:Static res:Strings.Tooltip_SafetyContour}"
                     AutomationProperties.AutomationId="ProjectOptions.SafetyContour"
                     AutomationProperties.Name="{x:Static res:Strings.Settings_SafetyContour}" />

            <TextBlock Grid.Row="4" Text="{x:Static res:Strings.Settings_SafetyDepth}" ToolTip="{x:Static res:Strings.Tooltip_SafetyDepth}"
                       Style="{DynamicResource Esri_TextBlockRegular}" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,2" IsEnabled="{Binding PortrayalEnabled}"
                     Text="{Binding SafetyDepth}" ToolTip="{x:Static res:Strings.Tooltip_SafetyDepth}"
                     AutomationProperties.AutomationId="ProjectOptions.SafetyDepth"
                     AutomationProperties.Name="{x:Static res:Strings.Settings_SafetyDepth}" />

            <TextBlock Grid.Row="5" Text="{x:Static res:Strings.Settings_ShallowContour}" ToolTip="{x:Static res:Strings.Tooltip_ShallowContour}"
                       Style="{DynamicResource Esri_TextBlockRegular}" VerticalAlignment="Center" />
            <TextBox Grid.Row="5" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,2" IsEnabled="{Binding PortrayalEnabled}"
                     Text="{Binding ShallowContour}" ToolTip="{x:Static res:Strings.Tooltip_ShallowContour}"
                     AutomationProperties.AutomationId="ProjectOptions.ShallowContour"
                     AutomationProperties.Name="{x:Static res:Strings.Settings_ShallowContour}" />

            <TextBlock Grid.Row="6" Text="{x:Static res:Strings.Settings_DeepContour}" ToolTip="{x:Static res:Strings.Tooltip_DeepContour}"
                       Style="{DynamicResource Esri_TextBlockRegular}" VerticalAlignment="Center" />
            <TextBox Grid.Row="6" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,2" IsEnabled="{Binding PortrayalEnabled}"
                     Text="{Binding DeepContour}" ToolTip="{x:Static res:Strings.Tooltip_DeepContour}"
                     AutomationProperties.AutomationId="ProjectOptions.DeepContour"
                     AutomationProperties.Name="{x:Static res:Strings.Settings_DeepContour}" />
          </Grid>

          <StackPanel Margin="0,6,0,0" IsEnabled="{Binding PortrayalEnabled}">
            <CheckBox Margin="0,2" IsChecked="{Binding FourShades}" Content="{x:Static res:Strings.Settings_FourShades}"
                      ToolTip="{x:Static res:Strings.Tooltip_FourShades}"
                      AutomationProperties.AutomationId="ProjectOptions.FourShades"
                      AutomationProperties.Name="{x:Static res:Strings.Settings_FourShades}" />
            <CheckBox Margin="0,2" IsChecked="{Binding ShallowWaterDangers}" Content="{x:Static res:Strings.Settings_ShallowWaterDangers}"
                      ToolTip="{x:Static res:Strings.Tooltip_ShallowWaterDangers}"
                      AutomationProperties.AutomationId="ProjectOptions.ShallowWaterDangers"
                      AutomationProperties.Name="{x:Static res:Strings.Settings_ShallowWaterDangers}" />
            <CheckBox Margin="0,2" IsChecked="{Binding PlainBoundaries}" Content="{x:Static res:Strings.Settings_PlainBoundaries}"
                      ToolTip="{x:Static res:Strings.Tooltip_PlainBoundaries}"
                      AutomationProperties.AutomationId="ProjectOptions.PlainBoundaries"
                      AutomationProperties.Name="{x:Static res:Strings.Settings_PlainBoundaries}" />
            <CheckBox Margin="0,2" IsChecked="{Binding SimplifiedSymbols}" Content="{x:Static res:Strings.Settings_SimplifiedSymbols}"
                      ToolTip="{x:Static res:Strings.Tooltip_SimplifiedSymbols}"
                      AutomationProperties.AutomationId="ProjectOptions.SimplifiedSymbols"
                      AutomationProperties.Name="{x:Static res:Strings.Settings_SimplifiedSymbols}" />
            <CheckBox Margin="0,2" IsChecked="{Binding FullLightLines}" Content="{x:Static res:Strings.Settings_FullLightLines}"
                      ToolTip="{x:Static res:Strings.Tooltip_FullLightLines}"
                      AutomationProperties.AutomationId="ProjectOptions.FullLightLines"
                      AutomationProperties.Name="{x:Static res:Strings.Settings_FullLightLines}" />
            <CheckBox Margin="0,2" IsChecked="{Binding IgnoreScaleMinimum}" Content="{x:Static res:Strings.Settings_IgnoreScaleMinimum}"
                      ToolTip="{x:Static res:Strings.Tooltip_IgnoreScaleMinimum}"
                      AutomationProperties.AutomationId="ProjectOptions.IgnoreScaleMinimum"
                      AutomationProperties.Name="{x:Static res:Strings.Settings_IgnoreScaleMinimum}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Problems}" Style="{DynamicResource Esri_TextBlockRegular}" Foreground="{DynamicResource Esri_TextErrorBrush}"
                 TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="ProjectOptions.Problems" />

      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button Content="{x:Static res:Strings.Settings_ResetToDefaults}" ToolTip="{x:Static res:Strings.Tooltip_ResetToDefaults}"
                Command="{Binding ResetToDefaultsCommand}" Style="{DynamicResource Esri_Button}"
                AutomationProperties.AutomationId="ProjectOptions.ResetToDefaults"
                AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_ResetToDefaults}" />
        <Button Content="{x:Static res:Strings.Settings_UseForNewProjects}" ToolTip="{x:Static res:Strings.Tooltip_UseForNewProjects}"
                Command="{Binding UseForNewProjectsCommand}" Style="{DynamicResource Esri_Button}"
                AutomationProperties.AutomationId="ProjectOptions.UseForNewProjects"
                AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_UseForNewProjects}" />
      </StackPanel>
      <TextBlock Text="{Binding Note}" Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,4,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
