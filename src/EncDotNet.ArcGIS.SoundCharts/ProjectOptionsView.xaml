<UserControl x:Class="EncDotNet.SoundCharts.ProjectOptionsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:res="clr-namespace:EncDotNet.SoundCharts.Resources"
             xmlns:sc="clr-namespace:EncDotNet.SoundCharts.Themes"
             AutomationProperties.AutomationId="ProjectOptions">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml" />
        <sc:SoundChartsTheme />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

      <!-- A field group's problem: an error message bar right under the
           group, collapsed while there's none. -->
      <Style x:Key="FieldProblem" TargetType="HeaderedContentControl" BasedOn="{StaticResource SC_MessageBar}">
        <Setter Property="sc:Tone.Value" Value="Danger" />
        <Setter Property="Margin" Value="{StaticResource SC_FormRowMargin}" />
        <Style.Triggers>
          <Trigger Property="Content" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- A label in the form grid's label column, level with its field
           (whose row margin is SC_FormRowMargin). -->
      <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource SC_FormLabel}">
        <Setter Property="Margin" Value="0,0,12,8" />
      </Style>

      <!-- The unit after a value box ("m"): SC_UnitSuffix in the design, laid
           out beside the box (look and feel design §11.11). -->
      <Style x:Key="UnitSuffix" TargetType="TextBlock" BasedOn="{StaticResource SC_Caption}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource SC_ToolbarItemGap}" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{StaticResource SC_PaneGutter}">
      <TextBlock Text="{x:Static res:Strings.Settings_ProjectHeading}" Style="{StaticResource SC_PageTitle}" />
      <TextBlock Style="{StaticResource SC_Caption}" Margin="0,2,0,0">
        <Run Text="{x:Static res:Strings.Settings_ProjectNote}" />
        <Run Text="{x:Static res:Strings.Settings_ScopeNote}" />
      </TextBlock>

      <!-- Display. -->
      <Expander Style="{StaticResource SC_FoldableSectionHeader}" IsExpanded="True"
                Header="{x:Static res:Strings.Settings_DisplaySection}"
                AutomationProperties.AutomationId="ProjectOptions.DisplaySection">
        <StackPanel>
          <!-- Settings the chart server doesn't take yet (U1): kept and shown, but disabled. -->
          <HeaderedContentControl Style="{StaticResource SC_MessageBar}"
                                  Content="{x:Static res:Strings.Settings_NeedsServer}"
                                  Margin="{StaticResource SC_FormRowMargin}"
                                  Visibility="{Binding DisplayNeedsServer, Converter={StaticResource BooleanToVisibility}}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{StaticResource SC_FormLabelColumnOptions}" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Settings_Palette}" Style="{StaticResource FormLabel}" />
            <ComboBox Grid.Row="0" Grid.Column="1" Width="{StaticResource SC_FormSliderWidth}" HorizontalAlignment="Left"
                      Margin="{StaticResource SC_FormRowMargin}"
                      ItemsSource="{Binding Palettes}" SelectedItem="{Binding Palette}" DisplayMemberPath="Label"
                      AutomationProperties.AutomationId="ProjectOptions.Palette"
                      AutomationProperties.Name="{x:Static res:Strings.Settings_Palette}" />

            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Settings_DisplayCategory}" Style="{StaticResource FormLabel}" />
            <ComboBox Grid.Row="1" Grid.Column="1" Width="{StaticResource SC_FormSliderWidth}" HorizontalAlignment="Left"
                      Margin="{StaticResource SC_FormRowMargin}"
                      IsEnabled="{Binding DisplayCategoryEnabled}"
                      ItemsSource="{Binding DisplayCategories}" SelectedItem="{Binding DisplayCategory}" DisplayMemberPath="Label"
                      AutomationProperties.AutomationId="ProjectOptions.DisplayCategory"
                      AutomationProperties.Name="{x:Static res:Strings.Settings_DisplayCategory}" />

            <CheckBox Grid.Row="2" Grid.Column="1" Margin="{StaticResource SC_FormRowMargin}" IsChecked="{Binding ShowText}"
                      Content="{x:Static res:Strings.Settings_Text}" ToolTip="{x:Static res:Strings.Tooltip_Text}"
                      AutomationProperties.AutomationId="ProjectOptions.Text"
                      AutomationProperties.Name="{x:Static res:Strings.Settings_Text}" />

            <CheckBox Grid.Row="3" Grid.Column="1" Margin="{StaticResource SC_FormRowMargin}" IsChecked="{Binding ShowSoundings}" IsEnabled="{Binding SoundingsEnabled}"
                      Content="{x:Static res:Strings.Settings_Soundings}"
                      AutomationProperties.AutomationId="ProjectOptions.Soundings"
                      AutomationProperties.Name="{x:Static res:Strings.Settings_Soundings}" />

            <TextBlock Grid.Row="4" Text="{x:Static res:Strings.Settings_SymbolScale}" ToolTip="{x:Static res:Strings.Tooltip_SymbolScale}"
                       Style="{StaticResource FormLabel}" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="{StaticResource SC_FormRowMargin}">
              <Slider Width="{StaticResource SC_FormSliderWidth}" Minimum="0.5" Maximum="3.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                      VerticalAlignment="Center"
                      Value="{Binding SymbolScale}" ToolTip="{x:Static res:Strings.Tooltip_SymbolScale}"
                      AutomationProperties.AutomationId="ProjectOptions.SymbolScale"
                      AutomationProperties.Name="{x:Static res:Strings.Settings_SymbolScale}" />
              <TextBlock Text="{Binding SymbolScaleText}" Style="{StaticResource SC_Mono}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="5" Text="{x:Static res:Strings.Settings_TextScale}" ToolTip="{x:Static res:Strings.Tooltip_TextScale}"
                       Style="{StaticResource FormLabel}" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="{StaticResource SC_FormRowMargin}">
              <Slider Width="{StaticResource SC_FormSliderWidth}" Minimum="0.5" Maximum="3.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                      VerticalAlignment="Center"
                      Value="{Binding TextScale}" ToolTip="{x:Static res:Strings.Tooltip_TextScale}"
                      AutomationProperties.AutomationId="ProjectOptions.TextScale"
                      AutomationProperties.Name="{x:Static res:Strings.Settings_TextScale}" />
              <TextBlock Text="{Binding TextScaleText}" Style="{StaticResource SC_Mono}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="6" Text="{x:Static res:Strings.Settings_NationalLanguage}" ToolTip="{x:Static res:Strings.Tooltip_NationalLanguage}"
                       Style="{StaticResource FormLabel}" />
            <TextBox Grid.Row="6" Grid.Column="1" Width="{StaticResource SC_FormInputWidth}" HorizontalAlignment="Left"
                     Margin="{StaticResource SC_FormRowMargin}" MaxLength="3"
                     FontFamily="{StaticResource SC_MonoFontFamily}"
                     Text="{Binding NationalLanguage, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{x:Static res:Strings.Tooltip_NationalLanguage}"
                     AutomationProperties.AutomationId="ProjectOptions.NationalLanguage"
                     AutomationProperties.Name="{x:Static res:Strings.Settings_NationalLanguage}" />
          </Grid>
          <HeaderedContentControl Style="{StaticResource FieldProblem}" Content="{Binding DisplayProblems}"
                                  AutomationProperties.AutomationId="ProjectOptions.DisplayProblems" />
        </StackPanel>
      </Expander>

      <!-- Depths (metres). -->
      <Expander Style="{StaticResource SC_FoldableSectionHeader}" IsExpanded="True"
                Header="{x:Static res:Strings.Settings_DepthsSection}"
                AutomationProperties.AutomationId="ProjectOptions.DepthsSection">
        <StackPanel>
          <HeaderedContentControl Style="{StaticResource SC_MessageBar}"
                                  Content="{x:Static res:Strings.Settings_NeedsServer}"
                                  Margin="{StaticResource SC_FormRowMargin}"
                                  Visibility="{Binding DepthsNeedServer, Converter={StaticResource BooleanToVisibility}}" />
          <Grid IsEnabled="{Binding PortrayalEnabled}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{StaticResource SC_FormLabelColumnOptions}" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Settings_SafetyContour}" ToolTip="{x:Static res:Strings.Tooltip_SafetyContour}"
                       Style="{StaticResource FormLabel}" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="{StaticResource SC_FormRowMargin}">
              <TextBox Width="{StaticResource SC_FormInputWidth}"
                       Text="{Binding SafetyContour}" ToolTip="{x:Static res:Strings.Tooltip_SafetyContour}"
                       AutomationProperties.AutomationId="ProjectOptions.SafetyContour"
                       AutomationProperties.Name="{x:Static res:Strings.Settings_SafetyContour}" />
              <TextBlock Text="{x:Static res:Strings.Settings_UnitMetres}" Style="{StaticResource UnitSuffix}" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Settings_SafetyDepth}" ToolTip="{x:Static res:Strings.Tooltip_SafetyDepth}"
                       Style="{StaticResource FormLabel}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="{StaticResource SC_FormRowMargin}">
              <TextBox Width="{StaticResource SC_FormInputWidth}"
                       Text="{Binding SafetyDepth}" ToolTip="{x:Static res:Strings.Tooltip_SafetyDepth}"
                       AutomationProperties.AutomationId="ProjectOptions.SafetyDepth"
                       AutomationProperties.Name="{x:Static res:Strings.Settings_SafetyDepth}" />
              <TextBlock Text="{x:Static res:Strings.Settings_UnitMetres}" Style="{StaticResource UnitSuffix}" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Settings_ShallowContour}" ToolTip="{x:Static res:Strings.Tooltip_ShallowContour}"
                       Style="{StaticResource FormLabel}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="{StaticResource SC_FormRowMargin}">
              <TextBox Width="{StaticResource SC_FormInputWidth}"
                       Text="{Binding ShallowContour}" ToolTip="{x:Static res:Strings.Tooltip_ShallowContour}"
                       AutomationProperties.AutomationId="ProjectOptions.ShallowContour"
                       AutomationProperties.Name="{x:Static res:Strings.Settings_ShallowContour}" />
              <TextBlock Text="{x:Static res:Strings.Settings_UnitMetres}" Style="{StaticResource UnitSuffix}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="{x:Static res:Strings.Settings_DeepContour}" ToolTip="{x:Static res:Strings.Tooltip_DeepContour}"
                       Style="{StaticResource FormLabel}" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="{StaticResource SC_FormRowMargin}">
              <TextBox Width="{StaticResource SC_FormInputWidth}"
                       Text="{Binding DeepContour}" ToolTip="{x:Static res:Strings.Tooltip_DeepContour}"
                       AutomationProperties.AutomationId="ProjectOptions.DeepContour"
                       AutomationProperties.Name="{x:Static res:Strings.Settings_DeepContour}" />
              <TextBlock Text="{x:Static res:Strings.Settings_UnitMetres}" Style="{StaticResource UnitSuffix}" />
            </StackPanel>
          </Grid>
          <HeaderedContentControl Style="{StaticResource FieldProblem}" Content="{Binding DepthProblems}"
                                  AutomationProperties.AutomationId="ProjectOptions.DepthProblems" />

          <Grid IsEnabled="{Binding PortrayalEnabled}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{StaticResource SC_FormLabelColumnOptions}" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1">
              <CheckBox Margin="{StaticResource SC_FormRowMargin}" IsChecked="{Binding FourShades}" Content="{x:Static res:Strings.Settings_FourShades}"
                        ToolTip="{x:Static res:Strings.Tooltip_FourShades}"
                        AutomationProperties.AutomationId="ProjectOptions.FourShades"
                        AutomationProperties.Name="{x:Static res:Strings.Settings_FourShades}" />
              <CheckBox Margin="{StaticResource SC_FormRowMargin}" IsChecked="{Binding ShallowWaterDangers}" Content="{x:Static res:Strings.Settings_ShallowWaterDangers}"
                        ToolTip="{x:Static res:Strings.Tooltip_ShallowWaterDangers}"
                        AutomationProperties.AutomationId="ProjectOptions.ShallowWaterDangers"
                        AutomationProperties.Name="{x:Static res:Strings.Settings_ShallowWaterDangers}" />
              <CheckBox Margin="{StaticResource SC_FormRowMargin}" IsChecked="{Binding PlainBoundaries}" Content="{x:Static res:Strings.Settings_PlainBoundaries}"
                        ToolTip="{x:Static res:Strings.Tooltip_PlainBoundaries}"
                        AutomationProperties.AutomationId="ProjectOptions.PlainBoundaries"
                        AutomationProperties.Name="{x:Static res:Strings.Settings_PlainBoundaries}" />
              <CheckBox Margin="{StaticResource SC_FormRowMargin}" IsChecked="{Binding SimplifiedSymbols}" Content="{x:Static res:Strings.Settings_SimplifiedSymbols}"
                        ToolTip="{x:Static res:Strings.Tooltip_SimplifiedSymbols}"
                        AutomationProperties.AutomationId="ProjectOptions.SimplifiedSymbols"
                        AutomationProperties.Name="{x:Static res:Strings.Settings_SimplifiedSymbols}" />
              <CheckBox Margin="{StaticResource SC_FormRowMargin}" IsChecked="{Binding FullLightLines}" Content="{x:Static res:Strings.Settings_FullLightLines}"
                        ToolTip="{x:Static res:Strings.Tooltip_FullLightLines}"
                        AutomationProperties.AutomationId="ProjectOptions.FullLightLines"
                        AutomationProperties.Name="{x:Static res:Strings.Settings_FullLightLines}" />
              <CheckBox Margin="{StaticResource SC_FormRowMargin}" IsChecked="{Binding IgnoreScaleMinimum}" Content="{x:Static res:Strings.Settings_IgnoreScaleMinimum}"
                        ToolTip="{x:Static res:Strings.Tooltip_IgnoreScaleMinimum}"
                        AutomationProperties.AutomationId="ProjectOptions.IgnoreScaleMinimum"
                        AutomationProperties.Name="{x:Static res:Strings.Settings_IgnoreScaleMinimum}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Expander>

      <!-- Route check: design brief §5.2, D24; inputs beside a route's own values. -->
      <Expander Style="{StaticResource SC_FoldableSectionHeader}" IsExpanded="True"
                Header="{x:Static res:Strings.Settings_RouteCheckSection}"
                AutomationProperties.AutomationId="ProjectOptions.RouteCheckSection">
        <StackPanel>
          <TextBlock Text="{x:Static res:Strings.Settings_RouteCheckNote}" Style="{StaticResource SC_Caption}" Margin="{StaticResource SC_FormRowMargin}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{StaticResource SC_FormLabelColumnOptions}" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Settings_Draft}" ToolTip="{x:Static res:Strings.Tooltip_Draft}"
                       Style="{StaticResource FormLabel}" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="{StaticResource SC_FormRowMargin}">
              <TextBox Width="{StaticResource SC_FormInputWidth}"
                       Text="{Binding Draft, TargetNullValue=''}" ToolTip="{x:Static res:Strings.Tooltip_Draft}"
                       AutomationProperties.AutomationId="ProjectOptions.Draft"
                       AutomationProperties.Name="{x:Static res:Strings.Settings_Draft}" />
              <TextBlock Text="{x:Static res:Strings.Settings_UnitMetres}" Style="{StaticResource UnitSuffix}" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Settings_UkcMargin}" ToolTip="{x:Static res:Strings.Tooltip_UkcMargin}"
                       Style="{StaticResource FormLabel}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="{StaticResource SC_FormRowMargin}">
              <TextBox Width="{StaticResource SC_FormInputWidth}"
                       Text="{Binding UkcMargin, TargetNullValue=''}" ToolTip="{x:Static res:Strings.Tooltip_UkcMargin}"
                       AutomationProperties.AutomationId="ProjectOptions.UkcMargin"
                       AutomationProperties.Name="{x:Static res:Strings.Settings_UkcMargin}" />
              <TextBlock Text="{x:Static res:Strings.Settings_UnitMetres}" Style="{StaticResource UnitSuffix}" />
            </StackPanel>
          </Grid>
          <HeaderedContentControl Style="{StaticResource FieldProblem}" Content="{Binding RouteCheckProblems}"
                                  AutomationProperties.AutomationId="ProjectOptions.RouteCheckProblems" />
        </StackPanel>
      </Expander>

      <WrapPanel Margin="0,12,0,0">
        <Button Content="{x:Static res:Strings.Settings_ResetToDefaults}" ToolTip="{x:Static res:Strings.Tooltip_ResetToDefaults}"
                Command="{Binding ResetToDefaultsCommand}" Style="{DynamicResource Esri_Button}"
                MinWidth="{StaticResource SC_DialogButtonMinWidth}"
                AutomationProperties.AutomationId="ProjectOptions.ResetToDefaults"
                AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_ResetToDefaults}" />
        <Button Content="{x:Static res:Strings.Settings_UseForNewProjects}" ToolTip="{x:Static res:Strings.Tooltip_UseForNewProjects}"
                Command="{Binding UseForNewProjectsCommand}" Style="{DynamicResource Esri_Button}"
                MinWidth="{StaticResource SC_DialogButtonMinWidth}"
                Margin="{StaticResource SC_ButtonGap}"
                AutomationProperties.AutomationId="ProjectOptions.UseForNewProjects"
                AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_UseForNewProjects}" />

        <!-- The confirmation after Use for New Projects: a success caption with a tick. -->
        <StackPanel Orientation="Horizontal" Margin="{StaticResource SC_ButtonGap}" VerticalAlignment="Center"
                    TextElement.Foreground="{DynamicResource SC_SuccessBrush}"
                    AutomationProperties.LiveSetting="Polite">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Path Style="{StaticResource SC_GlyphSmall}" Data="{StaticResource SC_GlyphSuccess}" VerticalAlignment="Center" Margin="0,0,4,0" />
          <TextBlock Text="{Binding Note}" Style="{StaticResource SC_Caption}" Foreground="{DynamicResource SC_SuccessBrush}"
                     VerticalAlignment="Center" AutomationProperties.AutomationId="ProjectOptions.Note" />
        </StackPanel>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
