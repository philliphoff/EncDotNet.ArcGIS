<UserControl x:Class="EncDotNet.SoundCharts.ScaleNoteView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:res="clr-namespace:EncDotNet.SoundCharts.Resources"
             xmlns:sc="clr-namespace:EncDotNet.SoundCharts.Themes">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml" />
        <sc:SoundChartsTheme />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <!-- Design brief §2.2: a read-only label. Pro's labelControl is static, so a
       custom control carries the changing text. The status-label pattern
       (look and feel design §5.7): a 16 px glyph in the note's tone and one
       line of text. With nothing to say the text is empty and the glyph is
       dimmed (§10 decision 11), so the label never leaves a blank gap. -->
  <DockPanel MaxWidth="{StaticResource SC_StatusLabelMaxWidth}"
             Margin="4,2"
             VerticalAlignment="Center"
             ToolTip="{Binding State.ToolTip}">
    <!-- The info shape in every state, as the mockup: Warning colours it,
         Neutral dims it. -->
    <Path DockPanel.Dock="Left"
          Style="{StaticResource SC_ToneGlyph}"
          Data="{StaticResource SC_GlyphInfo}"
          sc:Tone.Value="{Binding State.Tone, Converter={StaticResource SC_ToneConverter}}" />
    <TextBlock Text="{Binding State.Text}"
               Style="{StaticResource SC_StatusLabel}"
               Margin="{StaticResource SC_ToolbarItemGap}"
               AutomationProperties.AutomationId="ScaleNote.Text"
               AutomationProperties.Name="{x:Static res:Strings.ScaleNote_AccessibleName}"
               AutomationProperties.LiveSetting="Polite" />
  </DockPanel>
</UserControl>
