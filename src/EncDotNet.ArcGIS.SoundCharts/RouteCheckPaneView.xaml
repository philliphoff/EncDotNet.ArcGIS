<UserControl x:Class="EncDotNet.SoundCharts.RouteCheckPaneView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:res="clr-namespace:EncDotNet.SoundCharts.Resources"
             x:Name="Root"
             AutomationProperties.AutomationId="RouteCheck">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <CollectionViewSource x:Key="GroupedItems" Source="{Binding Items}">
        <CollectionViewSource.GroupDescriptions>
          <PropertyGroupDescription PropertyName="Group" />
        </CollectionViewSource.GroupDescriptions>
      </CollectionViewSource>

      <!-- Text that collapses when it has nothing to say. -->
      <Style x:Key="OptionalText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Esri_TextStyleDefaultBrush}" />
        <Style.Triggers>
          <Trigger Property="Text" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed" />
          </Trigger>
          <Trigger Property="Text" Value="">
            <Setter Property="Visibility" Value="Collapsed" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- The viewer's tones: destructive red, warning amber, success green. -->
      <Style x:Key="ToneBar" TargetType="Border">
        <Setter Property="Width" Value="4" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Background" Value="{DynamicResource Esri_BorderBrush}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Tone}" Value="Destructive">
            <Setter Property="Background" Value="#D62728" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="Warning">
            <Setter Property="Background" Value="#F29900" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Tone}" Value="Success">
            <Setter Property="Background" Value="#2CA02C" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="80" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- What to check. -->
    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
      <Button Content="{x:Static res:Strings.RouteCheck_CheckSelectedLine}"
              ToolTip="{x:Static res:Strings.RouteCheck_CheckSelectedLineTooltip}"
              Command="{Binding CheckSelectedLineCommand}"
              Style="{DynamicResource Esri_Button}"
              Margin="0,0,6,4"
              AutomationProperties.AutomationId="RouteCheck.CheckSelectedLine" />
      <Button Content="{x:Static res:Strings.RouteCheck_DrawRoute}"
              ToolTip="{x:Static res:Strings.RouteCheck_DrawRouteTooltip}"
              Command="{Binding DrawRouteCommand}"
              Style="{DynamicResource Esri_Button}"
              Margin="0,0,6,4"
              AutomationProperties.AutomationId="RouteCheck.DrawRoute" />
      <Button Content="{x:Static res:Strings.RouteCheck_OpenRoute}"
              ToolTip="{x:Static res:Strings.RouteCheck_OpenRouteTooltip}"
              Command="{Binding OpenRouteCommand}"
              Style="{DynamicResource Esri_Button}"
              Margin="0,0,6,4"
              AutomationProperties.AutomationId="RouteCheck.OpenRoute" />
      <Button Content="{x:Static res:Strings.RouteCheck_CheckAgain}"
              ToolTip="{x:Static res:Strings.RouteCheck_CheckAgainTooltip}"
              Command="{Binding CheckAgainCommand}"
              Style="{DynamicResource Esri_Button}"
              Margin="0,0,6,4"
              AutomationProperties.AutomationId="RouteCheck.CheckAgain" />
    </WrapPanel>

    <!-- The verdict card: route, parameters, verdict, summary rows. -->
    <StackPanel Grid.Row="1" Margin="0,0,0,6">
      <TextBlock Text="{Binding Heading}"
                 Style="{DynamicResource Esri_TextBlockH5}"
                 TextWrapping="Wrap"
                 AutomationProperties.AutomationId="RouteCheck.Heading" />
      <TextBlock Text="{Binding Parameters}"
                 Style="{StaticResource OptionalText}"
                 Foreground="{DynamicResource Esri_TextStyleSubduedBrush}"
                 Margin="0,2,0,0"
                 AutomationProperties.AutomationId="RouteCheck.Parameters" />
      <TextBlock Text="{Binding Message}"
                 Style="{StaticResource OptionalText}"
                 Margin="0,4,0,0"
                 AutomationProperties.AutomationId="RouteCheck.Message" />
      <DockPanel Margin="0,6,0,0" LastChildFill="True">
        <Border DockPanel.Dock="Left" Style="{StaticResource ToneBar}" />
        <StackPanel>
          <TextBlock Text="{Binding Title}"
                     Style="{StaticResource OptionalText}"
                     FontWeight="SemiBold"
                     FontSize="14"
                     AutomationProperties.AutomationId="RouteCheck.Verdict" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource OptionalText}" Margin="0,2,0,0" />
          <TextBlock Text="{Binding Confidence}"
                     Style="{StaticResource OptionalText}"
                     Foreground="{DynamicResource Esri_TextStyleSubduedBrush}"
                     Margin="0,2,0,0" />
          <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="0,4,0,0" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="RowLabel" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}"
                             Style="{DynamicResource Esri_TextBlockRegular}"
                             Foreground="{DynamicResource Esri_TextStyleSubduedBrush}"
                             Margin="0,0,12,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="2" Text="{Binding Chip}" Style="{StaticResource OptionalText}" FontWeight="SemiBold" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <!-- The findings, grouped MUST REVIEW, CHECK, INFO (D7). INFO starts folded, as in the viewer. -->
    <Grid Grid.Row="2">
      <ListBox ItemsSource="{Binding Source={StaticResource GroupedItems}}"
               SelectedItem="{Binding SelectedItem}"
               BorderThickness="0"
               Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               AutomationProperties.AutomationId="RouteCheck.Findings"
               AutomationProperties.Name="{x:Static res:Strings.RouteCheck_Findings}">
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.ContainerStyle>
              <Style TargetType="GroupItem">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                      <Expander Margin="0,4,0,0">
                        <Expander.Style>
                          <Style TargetType="Expander">
                            <Setter Property="IsExpanded" Value="True" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Name}" Value="{x:Static res:Strings.RouteCheck_GroupInfo}">
                                <Setter Property="IsExpanded" Value="False" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Expander.Style>
                        <Expander.Header>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Esri_TextStyleSubduedBrush}" />
                            <TextBlock Text="{Binding ItemCount}"
                                       Margin="6,0,0,0"
                                       Foreground="{DynamicResource Esri_TextStyleSubduedBrush}" />
                          </StackPanel>
                        </Expander.Header>
                        <ItemsPresenter />
                      </Expander>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </GroupStyle.ContainerStyle>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="0,2" LastChildFill="True" AutomationProperties.Name="{Binding Title}">
              <DockPanel.Style>
                <Style TargetType="DockPanel">
                  <Setter Property="ToolTip" Value="{x:Static res:Strings.RouteCheck_ZoomTooltip}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasLocation}" Value="False">
                      <Setter Property="ToolTip" Value="{x:Static res:Strings.RouteCheck_NoPlaceTooltip}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DockPanel.Style>
              <Border DockPanel.Dock="Left" Style="{StaticResource ToneBar}" Width="3" />
              <Button DockPanel.Dock="Right"
                      Content="{x:Static res:Strings.RouteCheck_ObjectInformation}"
                      ToolTip="{x:Static res:Strings.RouteCheck_ObjectInformationTooltip}"
                      Command="{Binding DataContext.ObjectInfoCommand, ElementName=Root}"
                      CommandParameter="{Binding}"
                      Style="{DynamicResource Esri_ButtonBorderless}"
                      VerticalAlignment="Top"
                      Margin="6,0,0,0"
                      AutomationProperties.AutomationId="RouteCheck.Finding.ObjectInfo" />
              <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{DynamicResource Esri_TextBlockRegular}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Meta}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource Esri_TextStyleSubduedBrush}" />
                <TextBlock Text="{Binding Tag}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource Esri_TextStyleSubduedBrush}" FontSize="10" />
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="{x:Static res:Strings.RouteCheck_Empty}"
                 Foreground="{DynamicResource Esri_TextStyleDefaultBrush}"
                 VerticalAlignment="Top"
                 AutomationProperties.AutomationId="RouteCheck.Empty">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsEmptyResult}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <!-- Datasets that couldn't be read, and the viewer's footer (§7.1). -->
    <StackPanel Grid.Row="3" Margin="0,6,0,0">
      <ItemsControl ItemsSource="{Binding Problems}"
                    Focusable="False"
                    AutomationProperties.AutomationId="RouteCheck.Problems"
                    AutomationProperties.Name="{x:Static res:Strings.RouteCheck_ProblemsHeading}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,2,0,0" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding Footer}"
                 Style="{StaticResource OptionalText}"
                 Foreground="{DynamicResource Esri_TextStyleSubduedBrush}"
                 Margin="0,4,0,0"
                 AutomationProperties.AutomationId="RouteCheck.Footer" />
    </StackPanel>
  </Grid>
</UserControl>
