<UserControl x:Class="EncDotNet.SoundCharts.ObjectInfoPaneView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:res="clr-namespace:EncDotNet.SoundCharts.Resources"
             xmlns:sc="clr-namespace:EncDotNet.SoundCharts.Themes"
             AutomationProperties.AutomationId="ObjectInfo">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml" />
        <sc:SoundChartsTheme />
      </ResourceDictionary.MergedDictionaries>

      <CollectionViewSource x:Key="GroupedItems" Source="{Binding Items}">
        <CollectionViewSource.GroupDescriptions>
          <PropertyGroupDescription PropertyName="Group" />
        </CollectionViewSource.GroupDescriptions>
      </CollectionViewSource>

      <!-- Each state has its own look (State on the view model). -->
      <Style x:Key="ResultsOnly" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding State}" Value="Results">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Before a click, with no layers, and with nothing at the point: an
           empty state with the state's glyph. -->
      <Style x:Key="StateEmpty" TargetType="HeaderedContentControl" BasedOn="{StaticResource SC_EmptyState}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding State}" Value="Empty">
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="sc:Ui.Glyph" Value="{StaticResource SC_GlyphObjectInfo}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="NoChartLayers">
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="sc:Ui.Glyph" Value="{StaticResource SC_GlyphLayers}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="NothingHere">
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="sc:Ui.Glyph" Value="{StaticResource SC_GlyphSearch}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="StateWorking" TargetType="ContentControl" BasedOn="{StaticResource SC_BusyState}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding State}" Value="Working">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="StateFailed" TargetType="HeaderedContentControl" BasedOn="{StaticResource SC_MessageBar}">
        <Setter Property="sc:Tone.Value" Value="Danger" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding State}" Value="Failed">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- The pick header: shown once there is a position. -->
      <Style x:Key="PickHeader" TargetType="Border" BasedOn="{StaticResource SC_PickHeader}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding Location}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- The time note, with its clock glyph; collapses with no note. -->
      <Style x:Key="TimeNote" TargetType="DockPanel">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding TimeNote}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- A list row: the glyph says feature, coverage value or warning. -->
      <Style x:Key="ItemRow" TargetType="HeaderedContentControl" BasedOn="{StaticResource SC_ListRow}">
        <Setter Property="sc:Ui.Glyph" Value="{StaticResource SC_GlyphInfo}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Kind}" Value="Coverage">
            <Setter Property="sc:Ui.Glyph" Value="{StaticResource SC_GlyphWater}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Kind}" Value="NavigationalWarning">
            <Setter Property="sc:Ui.Glyph" Value="{StaticResource SC_GlyphCheck}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- A navigational warning's "In force at map time" chip (D33). -->
      <Style x:Key="ValidityChip" TargetType="ContentControl" BasedOn="{StaticResource SC_Chip}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Validity}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- NOT FOR NAVIGATION, only where the producer marks the data (brief §7.1). -->
      <Style x:Key="NotForNavigationStrip" TargetType="ContentControl" BasedOn="{StaticResource SC_CautionStrip}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding NotForNavigation}" Value="True">
            <Setter Property="Visibility" Value="Visible" />
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- The text of a file an attribute refers to, under its row. -->
      <Style x:Key="AttributeText" TargetType="TextBox" BasedOn="{StaticResource SC_FieldValue}">
        <Setter Property="Padding" Value="0,2,0,4" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Text}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Pick header: count overline, position in mono, time note, Copy position. -->
    <Border Grid.Row="0" Style="{StaticResource PickHeader}">
      <DockPanel>
        <Button DockPanel.Dock="Right"
                VerticalAlignment="Top"
                Style="{StaticResource SC_IconButton}"
                sc:Ui.Glyph="{StaticResource SC_GlyphCopy}"
                Command="{Binding CopyPositionCommand}"
                ToolTip="{x:Static res:Strings.Tooltip_ObjectInfoCopyPosition}"
                AutomationProperties.Name="{x:Static res:Strings.ObjectInfo_CopyPosition}"
                AutomationProperties.HelpText="{x:Static res:Strings.Tooltip_ObjectInfoCopyPosition}"
                AutomationProperties.AutomationId="ObjectInfo.CopyPosition" />
        <StackPanel>
          <TextBlock Text="{Binding Overline}"
                     Style="{StaticResource SC_Overline}"
                     AutomationProperties.AutomationId="ObjectInfo.Heading" />
          <TextBlock Text="{Binding Location}"
                     Style="{StaticResource SC_Mono}"
                     Margin="0,2,0,0"
                     AutomationProperties.AutomationId="ObjectInfo.Location" />
          <DockPanel Style="{StaticResource TimeNote}" TextElement.Foreground="{DynamicResource Esri_TextStyleSubduedBrush}">
            <Path DockPanel.Dock="Left"
                  Style="{StaticResource SC_GlyphSmall}"
                  Data="{StaticResource SC_GlyphClock}"
                  VerticalAlignment="Top"
                  Margin="0,1,4,0" />
            <TextBlock Text="{Binding TimeNote}"
                       Style="{StaticResource SC_Caption}"
                       AutomationProperties.AutomationId="ObjectInfo.Time" />
          </DockPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Empty, no layers and nothing here. -->
    <HeaderedContentControl Grid.Row="1"
                            Style="{StaticResource StateEmpty}"
                            Header="{Binding Heading}"
                            Content="{Binding Description}"
                            AutomationProperties.AutomationId="ObjectInfo.EmptyState" />

    <!-- Working. -->
    <ContentControl Grid.Row="1"
                    Style="{StaticResource StateWorking}"
                    Content="{Binding Heading}"
                    AutomationProperties.AutomationId="ObjectInfo.Working" />

    <!-- Failed: an error message bar with a link to the Log. -->
    <HeaderedContentControl Grid.Row="1"
                            Margin="{StaticResource SC_PaneGutter}"
                            VerticalAlignment="Top"
                            Style="{StaticResource StateFailed}"
                            Header="{Binding Heading}"
                            AutomationProperties.AutomationId="ObjectInfo.Failed">
      <TextBlock>
        <Run Text="{Binding Description, Mode=OneWay}" /> <Hyperlink Command="{Binding ShowLogCommand}"
                   Style="{StaticResource SC_Hyperlink}"
                   AutomationProperties.AutomationId="ObjectInfo.ShowLog"><Run Text="{x:Static res:Strings.ObjectInfo_ShowLog}" /></Hyperlink>
      </TextBlock>
    </HeaderedContentControl>

    <!-- Results: the list, grouped by dataset, and the selected feature. -->
    <Grid Grid.Row="1" Style="{StaticResource ResultsOnly}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="60" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="2*" MinHeight="60" />
      </Grid.RowDefinitions>

      <ListBox Grid.Row="0"
               ItemsSource="{Binding Source={StaticResource GroupedItems}}"
               SelectedItem="{Binding SelectedItem}"
               BorderThickness="0"
               Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               AutomationProperties.AutomationId="ObjectInfo.Features"
               AutomationProperties.Name="{x:Static res:Strings.ObjectInfo_Features}">
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <ContentControl Style="{StaticResource SC_SectionHeader}"
                                Margin="8,12,8,4"
                                ToolTip="{Binding Name}"
                                AutomationProperties.Name="{Binding Name}">
                  <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource SC_ProductTag}" Content="{Binding Items[0].Spec}" />
                    <TextBlock Text="{Binding Items[0].DatasetName}"
                               Style="{StaticResource SC_Mono}"
                               Foreground="{DynamicResource Esri_TextStyleSubduedBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                  </StackPanel>
                </ContentControl>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <HeaderedContentControl Style="{StaticResource ItemRow}"
                                    sc:Tone.Value="{Binding Tone, Converter={StaticResource SC_ToneConverter}}"
                                    Header="{Binding Title}"
                                    AutomationProperties.Name="{Binding Title}">
              <TextBlock Text="{Binding Caption}" Style="{StaticResource SC_MonoSubdued}" TextTrimming="CharacterEllipsis" />
              <sc:Ui.Trailing>
                <ContentControl Style="{StaticResource ValidityChip}"
                                sc:Tone.Value="{Binding Tone, Converter={StaticResource SC_ToneConverter}}"
                                Content="{Binding Validity}" />
              </sc:Ui.Trailing>
            </HeaderedContentControl>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Row="1"
                    Style="{StaticResource SC_Splitter}"
                    AutomationProperties.AutomationId="ObjectInfo.Splitter" />

      <!-- The selected feature: attributes and associations. -->
      <ScrollViewer Grid.Row="2"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Focusable="False"
                    AutomationProperties.AutomationId="ObjectInfo.Details"
                    AutomationProperties.Name="{x:Static res:Strings.ObjectInfo_Details}">
        <StackPanel DataContext="{Binding SelectedItem}" Margin="{StaticResource SC_PaneGutter}">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <Trigger Property="DataContext" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <ContentControl Style="{StaticResource NotForNavigationStrip}"
                          Margin="0,0,0,8"
                          Content="{x:Static res:Strings.ObjectInfo_NotForNavigation}"
                          ToolTip="{x:Static res:Strings.ObjectInfo_NotForNavigationToolTip}"
                          AutomationProperties.AutomationId="ObjectInfo.NotForNavigation"
                          AutomationProperties.Name="{x:Static res:Strings.ObjectInfo_NotForNavigation}"
                          AutomationProperties.HelpText="{x:Static res:Strings.ObjectInfo_NotForNavigationToolTip}" />

          <TextBlock Text="{Binding Title}" Style="{StaticResource SC_Title}" />
          <TextBlock Text="{Binding Identity}" Style="{StaticResource SC_MonoSubdued}" Margin="0,2,0,0" />
          <ContentControl Style="{StaticResource ValidityChip}"
                          Margin="0,4,0,0"
                          sc:Tone.Value="{Binding Tone, Converter={StaticResource SC_ToneConverter}}"
                          Content="{Binding Validity}"
                          AutomationProperties.AutomationId="ObjectInfo.Validity"
                          AutomationProperties.Name="{Binding Validity}" />
          <TextBox Text="{Binding Source, Mode=OneWay}"
                   Style="{StaticResource SC_FieldValueMono}"
                   Foreground="{DynamicResource Esri_TextStyleSubduedBrush}"
                   Margin="0,2,0,0"
                   AutomationProperties.AutomationId="ObjectInfo.Source"
                   AutomationProperties.Name="{Binding Source}" />

          <ContentControl Style="{StaticResource SC_SectionHeader}" Content="{x:Static res:Strings.ObjectInfo_AttributesHeading}" />
          <TextBlock Text="{x:Static res:Strings.ObjectInfo_NoAttributes}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SC_Body}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Attributes.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ItemsControl ItemsSource="{Binding Attributes}" Style="{StaticResource SC_FieldGrid}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="{StaticResource SC_FieldRowMargin}" ToolTip="{Binding ToolTip}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SC_FieldLabel" MaxWidth="220" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource SC_FieldLabel}" Padding="{Binding Indent}" />
                  <!-- A read-only text box so the value can be selected and copied. -->
                  <TextBox Grid.Column="1"
                           Text="{Binding Value, Mode=OneWay}"
                           Style="{StaticResource SC_FieldValue}"
                           AutomationProperties.Name="{Binding Name}" />
                  <TextBox Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding Text, Mode=OneWay}"
                           Style="{StaticResource AttributeText}"
                           AutomationProperties.Name="{Binding Name}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding References.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <ContentControl Style="{StaticResource SC_SectionHeader}" Content="{x:Static res:Strings.ObjectInfo_ReferencesHeading}" />
            <ItemsControl ItemsSource="{Binding References}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Style="{StaticResource SC_Body}" Margin="{StaticResource SC_FieldRowMargin}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Datasets that couldn't be read: a warning message bar each. -->
    <ItemsControl Grid.Row="2"
                  ItemsSource="{Binding Problems}"
                  Focusable="False"
                  AutomationProperties.AutomationId="ObjectInfo.Problems"
                  AutomationProperties.Name="{x:Static res:Strings.ObjectInfo_Problems}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <HeaderedContentControl Style="{StaticResource SC_MessageBar}"
                                  sc:Tone.Value="Warning"
                                  Margin="8,0,8,8"
                                  Content="{Binding}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
