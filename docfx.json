{
  "build": {
    "content": [
      {
        "files": [
          "docs/**.md",
          "docs/**/toc.yml",
          "toc.yml",
          "index.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "docs/images/**",
          "docs/design/images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "docs/template"
    ],
    "globalMetadata": {
      "_appLogoPath": "docs/images/icon.svg",
      "_appFaviconPath": "docs/images/icon.svg",
      "_appName": "SoundCharts for ArcGIS",
      "_appTitle": "SoundCharts for ArcGIS Docs"
    }
  }
}
